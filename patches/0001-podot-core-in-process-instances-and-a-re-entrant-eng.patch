+#pragma once
+
+#include "core/input/input_event.h"
+#include "core/templates/hash_map.h"
+#include "core/templates/hash_set.h"
+#include "core/variant/callable.h"
+
+// Drawing-app style multi-touch navigation for touchscreens (used by the iPadOS editor):
+// - two-finger drag  -> InputEventPanGesture (canvases pan with the fingers),
+// - pinch            -> InputEventMagnifyGesture (zoom around the pinch center),
+// - two-finger tap   -> undo, three-finger tap -> redo (reported through a callback).
+// Single-finger input is forwarded unchanged, except that the first touch is held back for a
+// short moment: if a second finger arrives during that time, the first one is never delivered,
+// so starting a gesture doesn't select, draw or move anything. If the second finger arrives later,
+// the first touch is canceled.
+//
+// The recognizer is platform-independent: the platform feeds it raw touches and the current time,
+// and it emits the events to deliver (in order) through `p_emit`.
+class TouchGestureRecognizer {
+public:
+	enum TapAction {
+		TAP_NONE,
+		TAP_UNDO, // Two-finger tap.
+		TAP_REDO, // Three-finger tap.
+	};
+
+	// Pan gesture deltas are in pixels multiplied by this scale. With the editor's default 2D pan
+	// speed (20), the 2D canvas then follows the fingers exactly.
+	static constexpr float PAN_SCALE = 1.0f / 20.0f;
+	static constexpr uint64_t HOLD_USEC = 110000; // How long a first touch is held back.
+	static constexpr uint64_t TAP_MAX_USEC = 300000;
+
+	typedef void (*EmitFunc)(void *p_userdata, const Ref<InputEvent> &p_event);
+	typedef void (*TapFunc)(void *p_userdata, TapAction p_action);
+
+private:
+	enum Mode {
+		MODE_IDLE,
+		MODE_PENDING, // One finger down, not delivered yet.
+		MODE_PASSTHROUGH, // One finger, delivered as regular touch input.
+		MODE_GESTURE, // Two or more fingers: pan/zoom.
+	};
+
+	struct Finger {
+		Vector2 position;
+		Vector2 start_position;
+	};
+
+	Mode mode = MODE_IDLE;
+	HashMap<int, Finger> fingers;
+	int first_index = -1;
+	Ref<InputEventScreenTouch> pending_press;
+	uint64_t first_down_usec = 0;
+	uint64_t gesture_start_usec = 0;
+	int gesture_max_fingers = 0;
+	float gesture_max_travel = 0.0;
+	bool gesture_moved = false;
+	Vector2 last_center;
+	float last_distance = 0.0;
+	float move_threshold = 10.0; // Pixels.
+
+	HashSet<int> direct_fingers; // Touches that started in the direct-input area.
+
+	EmitFunc emit_func = nullptr;
+	TapFunc tap_func = nullptr;
+	void *userdata = nullptr;
+
+	void _emit(const Ref<InputEvent> &p_event);
+	void _flush_pending();
+	void _start_gesture(uint64_t p_usec);
+	void _update_gesture(const Vector2 &p_position);
+	bool _get_pair(Vector2 &r_center, float &r_distance) const;
+
+public:
+	bool enabled = false;
+	// Touches that start inside this area (window pixels) are delivered immediately and never
+	// become gestures, e.g. the game running in a window next to the editor (taps without delay).
+	static Rect2 direct_input_area;
+
+	void set_callbacks(EmitFunc p_emit, TapFunc p_tap, void *p_userdata);
+	void set_move_threshold(float p_pixels) { move_threshold = p_pixels; }
+
