+#include "touch_gesture_recognizer.h"
+
+void TouchGestureRecognizer::set_callbacks(EmitFunc p_emit, TapFunc p_tap, void *p_userdata) {
+	emit_func = p_emit;
+	tap_func = p_tap;
+	userdata = p_userdata;
+}
+
+void TouchGestureRecognizer::_emit(const Ref<InputEvent> &p_event) {
+	if (emit_func) {
+		emit_func(userdata, p_event);
+	}
+}
+
+void TouchGestureRecognizer::_flush_pending() {
+	if (pending_press.is_valid()) {
+		Ref<InputEventScreenTouch> press = pending_press;
+		pending_press.unref();
+		_emit(press);
+		// Deliver the finger's current position if it moved while held back.
+		const Finger *f = fingers.getptr(press->get_index());
+		if (f && f->position != press->get_position()) {
+			Ref<InputEventScreenDrag> drag;
+			drag.instantiate();
+			drag->set_index(press->get_index());
+			drag->set_position(f->position);
+			drag->set_relative(f->position - press->get_position());
+			drag->set_relative_screen_position(drag->get_relative());
+			_emit(drag);
+		}
+	}
+	mode = MODE_PASSTHROUGH;
+}
+
+bool TouchGestureRecognizer::_get_pair(Vector2 &r_center, float &r_distance) const {
+	// The gesture uses the centroid of all fingers, and the spread of the first two for zooming.
+	if (fingers.size() < 2) {
+		return false;
+	}
+	Vector2 sum;
+	Vector2 a, b;
+	int i = 0;
+	for (const KeyValue<int, Finger> &E : fingers) {
+		sum += E.value.position;
+		if (i == 0) {
+			a = E.value.position;
+		} else if (i == 1) {
+			b = E.value.position;
+		}
+		i++;
+	}
+	r_center = sum / fingers.size();
+	r_distance = a.distance_to(b);
+	return true;
+}
+
+void TouchGestureRecognizer::_start_gesture(uint64_t p_usec) {
+	if (mode == MODE_PENDING) {
+		// The first finger was never delivered: nothing to undo.
+		pending_press.unref();
+	} else if (mode == MODE_PASSTHROUGH && first_index != -1) {
+		// The first finger already started an interaction: cancel it.
+		Ref<InputEventScreenTouch> cancel;
+		cancel.instantiate();
+		cancel->set_index(first_index);
+		const Finger *f = fingers.getptr(first_index);
+		cancel->set_position(f ? f->position : Vector2());
+		cancel->set_pressed(false);
+		cancel->set_canceled(true);
+		_emit(cancel);
+	}
+	mode = MODE_GESTURE;
+	gesture_start_usec = first_down_usec ? first_down_usec : p_usec; // Taps are timed from the first finger.
+	gesture_max_fingers = fingers.size();
+	gesture_max_travel = 0.0;
+	gesture_moved = false;
+	_get_pair(last_center, last_distance);
+}
+
+void TouchGestureRecognizer::_update_gesture(const Vector2 &p_position) {
+	Vector2 center;
+	float distance;
+	if (!_get_pair(center, distance)) {
+		return;
+	}
+	const Vector2 pan = center - last_center;
+	if (pan != Vector2()) {
+		Ref<InputEventPanGesture> ev;
+		ev.instantiate();
+		ev->set_position(center);
+		// Content follows the fingers (like scrolling with natural direction).
+		ev->set_delta(-pan * PAN_SCALE);
+		_emit(ev);
+	}
+	if (last_distance > 0.0 && distance > 0.0 && distance != last_distance) {
+		Ref<InputEventMagnifyGesture> ev;
+		ev.instantiate();
+		ev->set_position(center);
+		ev->set_factor(distance / last_distance);
+		_emit(ev);
+	}
+	last_center = center;
+	last_distance = distance;
+}
+
+Rect2 TouchGestureRecognizer::direct_input_area;
+
+void TouchGestureRecognizer::touch_press(int p_index, const Vector2 &p_position, bool p_pressed, bool p_double_tap, uint64_t p_usec) {
+	if (enabled && p_pressed && mode == MODE_IDLE && direct_input_area.has_area() && direct_input_area.has_point(p_position)) {
+		direct_fingers.insert(p_index);
+	}
+	const bool direct = direct_fingers.has(p_index);
+	if (direct && !p_pressed) {
+		direct_fingers.erase(p_index);
+	}
+	if (!enabled || direct) {
+		Ref<InputEventScreenTouch> ev;
+		ev.instantiate();
+		ev->set_index(p_index);
+		ev->set_position(p_position);
+		ev->set_pressed(p_pressed);
+		ev->set_double_tap(p_double_tap);
+		_emit(ev);
+		return;
+	}
+
+	if (p_pressed) {
+		fingers[p_index] = { p_position, p_position };
+		switch (mode) {
+			case MODE_IDLE: {
+				first_index = p_index;
+				first_down_usec = p_usec;
+				pending_press.instantiate();
+				pending_press->set_index(p_index);
+				pending_press->set_position(p_position);
+				pending_press->set_pressed(true);
+				pending_press->set_double_tap(p_double_tap);
+				mode = MODE_PENDING;
+			} break;
+			case MODE_PENDING:
+			case MODE_PASSTHROUGH: {
+				_start_gesture(p_usec);
+			} break;
+			case MODE_GESTURE: {
+				gesture_max_fingers = MAX(gesture_max_fingers, (int)fingers.size());
+				_get_pair(last_center, last_distance);
+			} break;
+		}
+		return;
+	}
+
+	// Release.
+	const Finger *f = fingers.getptr(p_index);
+	if (!f) {
+		return;
+	}
+	switch (mode) {
+		case MODE_PENDING: {
+			// A quick tap: deliver it now.
+			_flush_pending();
+			[[fallthrough]];
+		}
+		case MODE_PASSTHROUGH: {
+			Ref<InputEventScreenTouch> ev;
+			ev.instantiate();
+			ev->set_index(p_index);
+			ev->set_position(p_position);
+			ev->set_pressed(false);
+			_emit(ev);
+		} break;
+		case MODE_GESTURE: {
+			gesture_max_travel = MAX(gesture_max_travel, f->start_position.distance_to(p_position));
+		} break;
+		case MODE_IDLE:
+			break;
+	}
+	fingers.erase(p_index);
+
+	if (fingers.is_empty()) {
+		if (mode == MODE_GESTURE && !gesture_moved && gesture_max_travel < move_threshold * 2.0 && p_usec - gesture_start_usec < TAP_MAX_USEC && tap_func) {
+			if (gesture_max_fingers == 2) {
+				tap_func(userdata, TAP_UNDO);
+			} else if (gesture_max_fingers == 3) {
+				tap_func(userdata, TAP_REDO);
+			}
+		}
+		mode = MODE_IDLE;
+		first_index = -1;
+		first_down_usec = 0;
+	} else if (mode == MODE_GESTURE) {
+		_get_pair(last_center, last_distance);
+	}
+}
+
+void TouchGestureRecognizer::touch_drag(int p_index, const Vector2 &p_position, const Ref<InputEventScreenDrag> &p_drag, uint64_t p_usec) {
+	if (!enabled || direct_fingers.has(p_index)) {
+		_emit(p_drag);
+		return;
+	}
+	Finger *f = fingers.getptr(p_index);
+	if (!f) {
+		return;
+	}
+	f->position = p_position;
+
+	switch (mode) {
+		case MODE_PENDING: {
+			if (f->start_position.distance_to(p_position) > move_threshold || p_usec - first_down_usec > HOLD_USEC) {
+				_flush_pending(); // Also delivers the movement so far.
+			}
+		} break;
+		case MODE_PASSTHROUGH: {
+			_emit(p_drag);
+		} break;
+		case MODE_GESTURE: {
+			gesture_max_travel = MAX(gesture_max_travel, f->start_position.distance_to(p_position));
+			if (gesture_max_travel > move_threshold) {
+				gesture_moved = true;
+			}
+			if (gesture_moved) {
+				_update_gesture(p_position);
+			} else {
+				// Keep the reference up to date until the gesture really starts moving.
+				_get_pair(last_center, last_distance);
+			}
+		} break;
+		case MODE_IDLE:
+			break;
+	}
+}
+
+void TouchGestureRecognizer::touch_cancel(int p_index, uint64_t p_usec) {
+	if (direct_fingers.has(p_index)) {
+		direct_fingers.erase(p_index);
+		Ref<InputEventScreenTouch> ev;
+		ev.instantiate();
+		ev->set_index(p_index);
+		ev->set_pressed(false);
+		ev->set_canceled(true);
+		_emit(ev);
+		return;
+	}
+	if (!enabled || mode == MODE_PASSTHROUGH) {
+		Ref<InputEventScreenTouch> ev;
+		ev.instantiate();
+		ev->set_index(p_index);
+		const Finger *f = fingers.getptr(p_index);
+		ev->set_position(f ? f->position : Vector2());
+		ev->set_pressed(false);
+		ev->set_canceled(true);
+		_emit(ev);
+	}
+	fingers.erase(p_index);
+	if (fingers.is_empty()) {
+		pending_press.unref();
+		mode = MODE_IDLE;
+		first_index = -1;
+	}
+}
+
+void TouchGestureRecognizer::update(uint64_t p_usec) {
+	if (enabled && mode == MODE_PENDING && p_usec - first_down_usec > HOLD_USEC) {
+		_flush_pending();
+	}
+}
