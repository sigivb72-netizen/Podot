diff --git a/core/input/input_map.cpp b/core/input/input_map.cpp
index d18a781..201483e 100644
--- a/core/input/input_map.cpp
+++ b/core/input/input_map.cpp
@@ -883,6 +883,14 @@ const HashMap<String, List<Ref<InputEvent>>> &InputMap::get_builtins() {
 	return default_builtin_cache;
 }
 
+// Apple devices with a hardware keyboard (iPadOS) use the macOS key conventions (Command/Option).
+static bool _is_override_supported(const String &p_feature) {
+	if (OS::get_singleton()->has_feature(p_feature)) {
+		return true;
+	}
+	return p_feature == "macos" && OS::prefer_meta_over_ctrl();
+}
+
 const HashMap<String, List<Ref<InputEvent>>> &InputMap::get_builtins_with_feature_overrides_applied() {
 	if (default_builtin_with_overrides_cache.size() > 0) {
 		return default_builtin_with_overrides_cache;
@@ -900,7 +908,7 @@ const HashMap<String, List<Ref<InputEvent>>> &InputMap::get_builtins_with_featur
 		const String &name = fullname.get_slicec('.', 0);
 		String override_for = fullname.get_slice_count(".") > 1 ? fullname.get_slicec('.', 1) : String();
 
-		if (!override_for.is_empty() && OS::get_singleton()->has_feature(override_for)) {
+		if (!override_for.is_empty() && _is_override_supported(override_for)) {
 			builtins_with_overrides[name].push_back(override_for);
 		}
 	}
@@ -916,7 +924,7 @@ const HashMap<String, List<Ref<InputEvent>>> &InputMap::get_builtins_with_featur
 			continue;
 		}
 
-		if (!override_for.is_empty() && !OS::get_singleton()->has_feature(override_for)) {
+		if (!override_for.is_empty() && !_is_override_supported(override_for)) {
 			// OS does not support this override - skip.
 			continue;
 		}
