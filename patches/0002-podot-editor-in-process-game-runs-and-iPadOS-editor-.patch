+#include "core/string/ustring.h"
+
+// Estimates whether a project fits the resources of the current device (RAM, free storage) before
+// it is opened. Mostly relevant on memory-constrained devices such as tablets (e.g. a 4 GB iPad),
+// where opening a huge project would otherwise get the app terminated by the OS without any message.
+struct ProjectDeviceLimits {
+	struct ProjectStats {
+		uint64_t source_bytes = 0; // Project files, excluding the import cache and hidden folders.
+		uint64_t imported_bytes = 0; // `.godot/imported` (already imported assets).
+		uint64_t largest_file_bytes = 0;
+		String largest_file;
+		int file_count = 0;
+		bool truncated = false; // The scan stopped early (too many files).
+	};
+
+	struct DeviceInfo {
+		uint64_t physical_memory = 0; // 0 if unknown.
+		uint64_t free_storage = 0; // 0 if unknown.
+	};
+
+	static constexpr int MAX_SCANNED_FILES = 100000;
+
+	static ProjectStats scan_project(const String &p_project_path);
