diff --git a/core/os/os.cpp b/core/os/os.cpp
index ffc0dff..f8169b4 100644
--- a/core/os/os.cpp
+++ b/core/os/os.cpp
@@ -662,6 +662,61 @@ List<String> OS::get_restart_on_exit_arguments() const {
 	return List<String>(restart_commandline);
 }
 
+void OS::begin_in_process_logger_scope() {
+	in_process_base_logger_count = _logger ? _logger->get_logger_count() : 0;
+}
+
+void OS::end_in_process_logger_scope() {
+	if (_logger && in_process_base_logger_count >= 0) {
+		_logger->truncate_loggers(in_process_base_logger_count);
+	}
+	in_process_base_logger_count = -1;
+}
+
+void OS::set_in_process_instances_enabled(bool p_enabled) {
+	in_process_instances = p_enabled;
+}
+
+bool OS::is_in_process_instances_enabled() const {
+	return in_process_instances;
+}
+
+void OS::queue_in_process_instance(const List<String> &p_arguments, bool p_front) {
+	if (p_front) {
+		pending_in_process_instances.push_front(p_arguments);
+	} else {
+		pending_in_process_instances.push_back(p_arguments);
+	}
+}
+
+bool OS::has_pending_in_process_instance() const {
+	return !pending_in_process_instances.is_empty();
+}
+
+List<String> OS::pop_pending_in_process_instance() {
+	ERR_FAIL_COND_V(pending_in_process_instances.is_empty(), List<String>());
+	List<String> args(pending_in_process_instances.front()->get());
+	pending_in_process_instances.pop_front();
+	return args;
+}
+
+void OS::clear_pending_in_process_instances() {
+	pending_in_process_instances.clear();
+}
+
+void OS::set_in_process_session_value(const String &p_key, const String &p_value) {
+	in_process_session_data[p_key] = p_value;
+}
+
+String OS::get_in_process_session_value(const String &p_key, const String &p_default) const {
+	const String *v = in_process_session_data.getptr(p_key);
+	return v ? *v : p_default;
+}
+
+void OS::erase_in_process_session_value(const String &p_key) {
+	in_process_session_data.erase(p_key);
+}
