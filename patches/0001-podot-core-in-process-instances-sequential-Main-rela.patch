index 2973bd0..82334d4 100644
--- a/core/io/logger.cpp
+++ b/core/io/logger.cpp
@@ -269,6 +269,15 @@ void CompositeLogger::add_logger(Logger *p_logger) {
 	loggers.push_back(p_logger);
 }
 
+void CompositeLogger::truncate_loggers(int p_count) {
+	ERR_FAIL_COND(p_count < 0);
+	while (loggers.size() > p_count) {
+		Logger *logger = loggers[loggers.size() - 1];
+		loggers.remove_at(loggers.size() - 1);
+		memdelete(logger);
+	}
+}
+
 CompositeLogger::~CompositeLogger() {
 	for (int i = 0; i < loggers.size(); ++i) {
 		memdelete(loggers[i]);
