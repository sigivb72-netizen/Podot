+#import "ios_file_import.h"
+
+#include "core/variant/variant.h"
+#import "drivers/apple_embedded/app_delegate_service.h"
+#import "drivers/apple_embedded/display_server_apple_embedded.h"
+#import "drivers/apple_embedded/godot_view_controller.h"
+
+#import <PhotosUI/PhotosUI.h>
+#import <UIKit/UIKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+// Copies of imported items live here until the editor has copied them into the project.
+static NSURL *_new_import_dir() {
+	NSURL *base = [[NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES] URLByAppendingPathComponent:@"podot_import" isDirectory:YES];
+	NSURL *dir = [base URLByAppendingPathComponent:[NSUUID UUID].UUIDString isDirectory:YES];
+	[[NSFileManager defaultManager] createDirectoryAtURL:dir withIntermediateDirectories:YES attributes:nil error:nil];
+	return dir;
+}
+
+static void _clear_old_imports() {
+	NSURL *base = [[NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES] URLByAppendingPathComponent:@"podot_import" isDirectory:YES];
+	[[NSFileManager defaultManager] removeItemAtURL:base error:nil];
+}
+
+static NSURL *_unique_destination(NSURL *p_dir, NSString *p_name) {
+	NSURL *dest = [p_dir URLByAppendingPathComponent:p_name];
+	int n = 2;
+	while ([[NSFileManager defaultManager] fileExistsAtPath:dest.path]) {
+		NSString *name = [NSString stringWithFormat:@"%@_%d", p_name.stringByDeletingPathExtension, n++];
+		if (p_name.pathExtension.length) {
+			name = [name stringByAppendingPathExtension:p_name.pathExtension];
+		}
+		dest = [p_dir URLByAppendingPathComponent:name];
+	}
+	return dest;
+}
+
+static NSString *_copy_into(NSURL *p_source, NSURL *p_dir, NSString *p_name) {
+	NSURL *dest = _unique_destination(p_dir, p_name.length ? p_name : p_source.lastPathComponent);
+	NSError *error = nil;
+	if ([[NSFileManager defaultManager] copyItemAtURL:p_source toURL:dest error:&error]) {
+		return dest.path;
+	}
+	NSLog(@"[Podot] import: could not copy %@: %@", p_source.lastPathComponent, error.localizedDescription);
+	return nil;
+}
+
+// Loads the items of the providers into `p_dir`, then calls `p_done` on the main thread with the paths.
+static void _load_providers(NSArray<NSItemProvider *> *p_providers, NSURL *p_dir, bool p_photos, void (^p_done)(NSArray<NSString *> *)) {
+	NSMutableArray<NSString *> *paths = [NSMutableArray array];
+	dispatch_group_t group = dispatch_group_create();
+	NSObject *lock = [NSObject new];
+
+	for (NSItemProvider *provider in p_providers) {
+		NSString *type = nil;
+		if (p_photos) {
+			// Godot can't import HEIC: prefer formats it knows.
+			for (NSString *candidate in @[ UTTypeJPEG.identifier, UTTypePNG.identifier, UTTypeWebP.identifier, UTTypeMovie.identifier ]) {
+				if ([provider hasItemConformingToTypeIdentifier:candidate]) {
+					type = candidate;
+					break;
+				}
+			}
+			if (!type && [provider canLoadObjectOfClass:[UIImage class]]) {
+				dispatch_group_enter(group);
+				NSString *name = [(provider.suggestedName ?: @"photo") stringByAppendingPathExtension:@"png"];
+				[provider loadObjectOfClass:[UIImage class]
+						  completionHandler:^(UIImage *image, NSError *error) {
+							  NSData *png = image ? UIImagePNGRepresentation(image) : nil;
+							  if (png) {
+								  @synchronized(lock) {
+									  NSURL *dest = _unique_destination(p_dir, name);
+									  if ([png writeToURL:dest atomically:YES]) {
+										  [paths addObject:dest.path];
+									  }
+								  }
+							  }
+							  dispatch_group_leave(group);
+						  }];
+				continue;
+			}
+		}
+		if (!type) {
+			// Folders first (their file representation is the folder itself), then the most specific type.
+			if ([provider hasItemConformingToTypeIdentifier:UTTypeFolder.identifier]) {
+				type = UTTypeFolder.identifier;
+			} else {
+				type = provider.registeredTypeIdentifiers.firstObject;
+			}
+		}
+		if (!type) {
+			continue;
+		}
+		dispatch_group_enter(group);
+		NSString *suggested = provider.suggestedName;
+		[provider loadFileRepresentationForTypeIdentifier:type
+										completionHandler:^(NSURL *url, NSError *error) {
+											// The URL is only valid inside this block: copy it now.
+											if (url) {
+												NSString *name = url.lastPathComponent;
+												if (suggested.length && url.pathExtension.length && ![name hasPrefix:suggested]) {
+													name = [suggested stringByAppendingPathExtension:url.pathExtension];
+												}
+												@synchronized(lock) {
+													NSString *copied = _copy_into(url, p_dir, name);
+													if (copied) {
+														[paths addObject:copied];
+													}
+												}
+											} else {
+												NSLog(@"[Podot] import: %@", error.localizedDescription);
+											}
+											dispatch_group_leave(group);
+										}];
+	}
+
+	dispatch_group_notify(group, dispatch_get_main_queue(), ^{
+		p_done(paths);
+	});
+}
+
+static PackedStringArray _to_godot(NSArray<NSString *> *p_paths) {
+	PackedStringArray ret;
+	for (NSString *path in p_paths) {
+		ret.push_back(String::utf8(path.UTF8String));
+	}
+	return ret;
+}
+
+// MARK: Drag and drop from other apps
+
+@interface GDTFileDropDelegate : NSObject <UIDropInteractionDelegate>
+@end
+
+@implementation GDTFileDropDelegate
+
+- (BOOL)dropInteraction:(UIDropInteraction *)interaction canHandleSession:(id<UIDropSession>)session {
+	return [session hasItemsConformingToTypeIdentifiers:@[ UTTypeItem.identifier, UTTypeFolder.identifier ]];
+}
+
+- (UIDropProposal *)dropInteraction:(UIDropInteraction *)interaction sessionDidUpdate:(id<UIDropSession>)session {
+	// Let the editor know where the drag is, so that the folder under the finger gets the files.
+	DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+	if (ds) {
+		CGPoint point = [session locationInView:interaction.view];
+		const CGFloat scale = interaction.view.contentScaleFactor;
+		ds->pointer_motion(Point2(point.x * scale, point.y * scale), 0.0, Vector2(), false, 0);
+	}
+	return [[UIDropProposal alloc] initWithDropOperation:UIDropOperationCopy];
+}
+
+- (void)dropInteraction:(UIDropInteraction *)interaction performDrop:(id<UIDropSession>)session {
+	NSMutableArray<NSItemProvider *> *providers = [NSMutableArray array];
+	for (UIDragItem *item in session.items) {
+		[providers addObject:item.itemProvider];
+	}
+	CGPoint point = [session locationInView:interaction.view];
+	const CGFloat scale = interaction.view.contentScaleFactor;
+	const Point2 position(point.x * scale, point.y * scale);
+
+	_clear_old_imports();
+	// Photos dragged from the Photos app are HEIC by default: use the photo conversion for images.
+	bool photos = true;
+	for (NSItemProvider *provider in providers) {
+		if (![provider hasItemConformingToTypeIdentifier:UTTypeImage.identifier] && ![provider hasItemConformingToTypeIdentifier:UTTypeMovie.identifier]) {
+			photos = false;
+		}
+	}
+	_load_providers(providers, _new_import_dir(), photos, ^(NSArray<NSString *> *paths) {
+		DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+		if (ds && paths.count > 0) {
+			ds->pointer_motion(position, 0.0, Vector2(), false, 0);
+			ds->send_dropped_files(_to_godot(paths));
+		}
+	});
+}
+
+@end
+
+static GDTFileDropDelegate *gdt_drop_delegate = nil;
+
+void ios_file_import_enable_drop(UIView *p_view) {
+	if (!gdt_drop_delegate) {
+		gdt_drop_delegate = [[GDTFileDropDelegate alloc] init];
+	}
+	[p_view addInteraction:[[UIDropInteraction alloc] initWithDelegate:gdt_drop_delegate]];
+}
+
+// MARK: Pickers
+
+@interface GDTImportPickerDelegate : NSObject <UIDocumentPickerDelegate, PHPickerViewControllerDelegate> {
+@public
+	Callable callback;
+}
+@end
+
+static GDTImportPickerDelegate *gdt_import_delegate = nil;
+
+@implementation GDTImportPickerDelegate
+
+- (void)finish:(NSArray<NSString *> *)paths {
+	if (callback.is_valid()) {
+		callback.call_deferred(_to_godot(paths));
+	}
+	gdt_import_delegate = nil;
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
+	// Opened "as copy": the URLs are temporary copies owned by the app.
+	NSURL *dir = _new_import_dir();
+	NSMutableArray<NSString *> *paths = [NSMutableArray array];
+	for (NSURL *url in urls) {
+		NSString *copied = _copy_into(url, dir, url.lastPathComponent);
+		if (copied) {
+			[paths addObject:copied];
+		}
+	}
+	[self finish:paths];
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+	[self finish:@[]];
+}
+
+- (void)picker:(PHPickerViewController *)picker didFinishPicking:(NSArray<PHPickerResult *> *)results API_AVAILABLE(ios(14.0)) {
+	[picker dismissViewControllerAnimated:YES completion:nil];
+	NSMutableArray<NSItemProvider *> *providers = [NSMutableArray array];
+	for (PHPickerResult *result in results) {
+		[providers addObject:result.itemProvider];
+	}
+	if (providers.count == 0) {
+		[self finish:@[]];
+		return;
+	}
+	_load_providers(providers, _new_import_dir(), true, ^(NSArray<NSString *> *paths) {
+		[self finish:paths];
+	});
+}
+
+@end
+
+static bool _begin_picker(const Callable &p_callback) {
+	if (gdt_import_delegate != nil || !GDTAppDelegateService.viewController) {
+		return false;
+	}
+	_clear_old_imports();
+	gdt_import_delegate = [[GDTImportPickerDelegate alloc] init];
+	gdt_import_delegate->callback = p_callback;
+	return true;
+}
+
+void ios_import_from_files(const Callable &p_callback) {
+	if (@available(iOS 14.0, *)) {
+		if (!_begin_picker(p_callback)) {
+			return;
+		}
+		UIDocumentPickerViewController *picker = [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:@[ UTTypeItem ] asCopy:YES];
+		picker.allowsMultipleSelection = YES;
+		picker.shouldShowFileExtensions = YES;
+		picker.delegate = gdt_import_delegate;
+		[GDTAppDelegateService.viewController presentViewController:picker animated:YES completion:nil];
+	}
+}
+
+void ios_import_from_photos(const Callable &p_callback) {
+	if (@available(iOS 14.0, *)) {
+		if (!_begin_picker(p_callback)) {
+			return;
+		}
+		PHPickerConfiguration *config = [[PHPickerConfiguration alloc] init];
+		config.selectionLimit = 0; // No limit.
+		// Ask Photos to convert HEIC/HEVC to JPEG/H.264 where it can.
+		config.preferredAssetRepresentationMode = PHPickerConfigurationAssetRepresentationModeCompatible;
+		PHPickerViewController *picker = [[PHPickerViewController alloc] initWithConfiguration:config];
+		picker.delegate = gdt_import_delegate;
+		[GDTAppDelegateService.viewController presentViewController:picker animated:YES completion:nil];
+	}
+}
