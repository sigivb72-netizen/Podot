+// UIKit does not report key repeats, so they are generated here for held keys (needed for text
+// editing and for navigating with the arrow keys).
+static const NSTimeInterval key_repeat_delay = 0.4;
+static const NSTimeInterval key_repeat_interval = 0.05;
+
+static bool _is_modifier_key(Key p_key) {
+	return p_key == Key::SHIFT || p_key == Key::CTRL || p_key == Key::ALT || p_key == Key::META || p_key == Key::CAPSLOCK;
+}
+
+- (void)stopKeyRepeat {
+	[self.keyRepeatTimer invalidate];
+	self.keyRepeatTimer = nil;
+	self.keyRepeatPress = nil;
+}
+
+- (void)sendPress:(UIPress *)press pressed:(BOOL)pressed echo:(BOOL)echo API_AVAILABLE(ios(13.4)) {
+	String u32lbl = String::utf8([press.key.charactersIgnoringModifiers UTF8String]);
+	String u32text = String::utf8([press.key.characters UTF8String]);
+	Key key = KeyMappingAppleEmbedded::remap_key(press.key.keyCode);
+
+	if (press.key.keyCode == 0 && u32text.is_empty() && u32lbl.is_empty()) {
+		return;
+	}
+
+	char32_t us = 0;
+	if (!u32lbl.is_empty() && !u32lbl.begins_with("UIKey")) {
+		us = u32lbl[0];
+	}
+
+	KeyLocation location = KeyMappingAppleEmbedded::key_location(press.key.keyCode);
+	// The modifier flags of the press itself are not updated while a key is held, use the current ones.
+	NSInteger modifiers = press.key.modifierFlags;
+
+	if (pressed && !u32text.is_empty() && !u32text.begins_with("UIKey")) {
+		for (int i = 0; i < u32text.length(); i++) {
+			const char32_t c = u32text[i];
+			DisplayServerAppleEmbedded::get_singleton()->key(fix_keycode(us, key), c, fix_key_label(us, key), key, modifiers, true, location, echo);
+		}
+	} else {
+		DisplayServerAppleEmbedded::get_singleton()->key(fix_keycode(us, key), 0, fix_key_label(us, key), key, modifiers, pressed, location, echo && pressed);
+	}
+}
+
+- (void)keyRepeatFired:(NSTimer *)timer {
+	if (!DisplayServerAppleEmbedded::get_singleton() || DisplayServerAppleEmbedded::get_singleton()->is_keyboard_active() || !self.keyRepeatPress) {
+		[self stopKeyRepeat];
+		return;
+	}
+	if (@available(iOS 13.4, *)) {
+		[self sendPress:self.keyRepeatPress pressed:YES echo:YES];
+	}
+	if (timer.timeInterval != key_repeat_interval) {
+		[self.keyRepeatTimer invalidate];
+		self.keyRepeatTimer = [NSTimer scheduledTimerWithTimeInterval:key_repeat_interval target:self selector:@selector(keyRepeatFired:) userInfo:nil repeats:YES];
+	}
+}
