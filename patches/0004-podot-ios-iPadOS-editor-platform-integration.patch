+	ios_crash_reporter_set_breadcrumb(p_phase);
+}
+
+#ifdef TOOLS_ENABLED
+extern char **gargv;
+
+bool OS_IOS::is_game_session_running() const {
+	return get_in_process_session_value("game_running") == "1";
+}
+
+void OS_IOS::stop_game_session() {
+	if (!is_game_session_running()) {
+		return;
+	}
+	SceneTree *tree = Object::cast_to<SceneTree>(OS::get_singleton()->get_main_loop());
+	if (tree) {
+		tree->quit();
+	}
+}
+
+bool OS_IOS::is_process_running(const ProcessID &p_pid) const {
+	// In-process instances are reported with PID 0 and are never running concurrently.
+	if (p_pid == 0 && is_in_process_instances_enabled()) {
+		return false;
+	}
+	return OS_AppleEmbedded::is_process_running(p_pid);
+}
+
+bool OS_IOS::handle_hardware_key_shortcut(Key p_key, NSInteger p_modifiers) {
+	if (!is_game_session_running()) {
+		return false;
+	}
+	// Same shortcut as the editor's "Stop Running Project" (F8), plus Command+. which is the
+	// conventional "stop" shortcut on Apple platforms.
+	const bool command = p_modifiers & UIKeyModifierCommand;
+	if (p_key == Key::F8 || (command && p_key == Key::PERIOD)) {
+		stop_game_session();
+		return true;
+	}
+	return false;
+}
+
+Error OS_IOS::shell_show_in_file_manager(String p_path, bool p_open_folder) {
+	// The Files app can show folders of this app's Documents directory (and folders opened through
+	// the document picker) with the "shareddocuments" URL scheme.
+	if (p_open_folder && !DirAccess::dir_exists_absolute(p_path)) {
+		p_path = p_path.get_base_dir();
+	}
+	return shell_open("shareddocuments://" + p_path.uri_encode().replace("%2F", "/"));
+}
+
+bool OS_IOS::handle_main_loop_quit() {
+	if (!is_in_process_instances_enabled()) {
+		return false;
+	}
+
+	const bool was_game = is_game_session_running();
+	// "Reload Current Project" / "Quit to Project List" queue their instance from Main::cleanup()
+	// (restart on exit), so only fall back to the project manager if nothing else will follow.
+	if (!has_pending_in_process_instance() && !is_restart_on_exit_set()) {
+		// iOS apps don't quit by themselves: go back to the project manager instead.
+		List<String> pm_args;
+		pm_args.push_back("--project-manager");
+		queue_in_process_instance(pm_args);
+	}
+
+	ipados_editor_set_game_controls_visible(false);
+
+	print_verbose("iPadOS: tearing down the current instance to start the next one in-process.");
+	note_phase(was_game ? "relaunch: Main::cleanup begin (game)" : "relaunch: Main::cleanup begin (editor/project manager)");
+	Main::cleanup(true);
+	note_phase("relaunch: Main::cleanup done");
+	ipados_editor_release_rendering_surface();
+
+	// Try the queued instances until one of them starts (e.g. a game without a main scene fails).
+	for (int attempt = 0; attempt < 4; attempt++) {
+		if (!has_pending_in_process_instance()) {
+			List<String> pm_args;
+			pm_args.push_back("--project-manager");
+			queue_in_process_instance(pm_args);
+		}
+		List<String> args = pop_pending_in_process_instance();
+		Vector<CharString> args_utf8;
+		Vector<char *> argv;
+		for (const String &arg : args) {
+			args_utf8.push_back(arg.utf8());
+		}
+		for (CharString &arg : args_utf8) {
+			argv.push_back(arg.ptrw());
+		}
+
+		increment_in_process_generation();
+		set_exit_code(EXIT_SUCCESS);
+		// Main::setup() keeps static StringNames alive on failure only if another instance is queued.
+		const bool added_fallback = !has_pending_in_process_instance();
+		if (added_fallback) {
+			List<String> pm_args;
+			pm_args.push_back("--project-manager");
+			queue_in_process_instance(pm_args);
+		}
+		{
+			String joined = "relaunch: Main::setup begin:";
+			for (const String &arg : args) {
+				joined += " " + arg.get_file();
+			}
+			note_phase(joined.utf8().get_data());
+		}
+		const Error err = Main::setup(gargv[0], argv.size(), argv.ptrw(), false);
+		note_phase(err == OK ? "relaunch: Main::setup done" : "relaunch: Main::setup FAILED");
+		if (err == OK && added_fallback) {
+			clear_pending_in_process_instances();
+		}
+		if (err == OK) {
+			initialize_modules();
+			const bool is_game = is_game_session_running();
+			ipados_editor_set_game_controls_visible(is_game);
+			ipados_editor_write_session_marker(is_game);
+			return true;
+		}
+		if (was_game || is_game_session_running()) {
+			// The game could not be set up: let the editor show the error.
+			set_in_process_session_value("game_running", "0");
+			set_in_process_session_value("game_exit_code", itos(EXIT_FAILURE));
+			set_in_process_session_value("game_end_ticks", itos(get_ticks_msec()));
+		}
+	}
+
+	alert("Godot could not start the next editor instance. Please restart the app.", "Godot Editor");
+	return true;
+}
