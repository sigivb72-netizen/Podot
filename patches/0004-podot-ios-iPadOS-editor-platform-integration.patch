+@interface GDTGameControlsHandler : NSObject
+- (void)stopPressed:(id)sender;
+- (void)dragged:(UIPanGestureRecognizer *)recognizer;
+@end
+
+@implementation GDTGameControlsHandler
+- (void)stopPressed:(id)sender {
+	OS_IOS *os = OS_IOS::get_singleton();
+	if (os) {
+		os->stop_game_session();
+	}
+}
+
+- (void)dragged:(UIPanGestureRecognizer *)recognizer {
+	UIView *view = recognizer.view;
+	UIView *container = view.superview;
+	CGPoint translation = [recognizer translationInView:container];
+	CGPoint center = CGPointMake(view.center.x + translation.x, view.center.y + translation.y);
+	CGRect bounds = container.bounds;
+	center.x = MAX(view.bounds.size.width / 2, MIN(bounds.size.width - view.bounds.size.width / 2, center.x));
+	center.y = MAX(view.bounds.size.height / 2, MIN(bounds.size.height - view.bounds.size.height / 2, center.y));
+	view.center = center;
+	[recognizer setTranslation:CGPointZero inView:container];
+}
+@end
+
+static UIButton *gdt_stop_button = nil;
+static GDTGameControlsHandler *gdt_controls_handler = nil;
+
+void ipados_editor_set_game_controls_visible(bool p_visible) {
+	UIView *root = GDTAppDelegateService.viewController.view;
+	if (!p_visible) {
+		[gdt_stop_button removeFromSuperview];
+		gdt_stop_button = nil;
+		return;
+	}
+	if (!root) {
+		return;
+	}
+	if (gdt_stop_button) {
+		[root bringSubviewToFront:gdt_stop_button];
+		return;
+	}
+	if (!gdt_controls_handler) {
+		gdt_controls_handler = [[GDTGameControlsHandler alloc] init];
+	}
+
+	UIButton *button = [UIButton buttonWithType:UIButtonTypeSystem];
+	[button setTitle:@" Stop" forState:UIControlStateNormal];
+	if (@available(iOS 13.0, *)) {
+		[button setImage:[UIImage systemImageNamed:@"stop.fill"] forState:UIControlStateNormal];
+	}
+	button.tintColor = UIColor.whiteColor;
+	button.backgroundColor = [UIColor colorWithRed:0.8 green:0.2 blue:0.2 alpha:0.75];
+	button.layer.cornerRadius = 18;
+	button.titleLabel.font = [UIFont boldSystemFontOfSize:15];
+	button.accessibilityLabel = @"Stop running project and return to the editor";
+	const CGFloat w = 96, h = 36;
+	const UIEdgeInsets safe = root.safeAreaInsets;
+	button.frame = CGRectMake(root.bounds.size.width - w - 12 - safe.right, 12 + safe.top, w, h);
+	button.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleBottomMargin;
+	[button addTarget:gdt_controls_handler action:@selector(stopPressed:) forControlEvents:UIControlEventTouchUpInside];
+	[button addGestureRecognizer:[[UIPanGestureRecognizer alloc] initWithTarget:gdt_controls_handler action:@selector(dragged:)]];
+	button.layer.zPosition = 1000; // Always above the rendering layer.
+	[root addSubview:button];
+	gdt_stop_button = button;
+}
+
+void ipados_editor_release_rendering_surface() {
+	[GDTAppDelegateService.viewController.godotView releaseRenderingLayer];
+}
+
+// Plain Foundation file access: the marker is read before Main (and FileAccess) is set up.
+static NSString *_marker_path() {
+	NSArray *paths = NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES);
+	return [[paths firstObject] stringByAppendingPathComponent:@"ipados_editor_session.txt"];
+}
+
+static NSString *_ns(const String &p_str) {
+	return [NSString stringWithUTF8String:p_str.utf8().get_data()];
+}
+
+void ipados_editor_write_session_marker(bool p_game_running) {
+	NSString *path = _marker_path();
+	if (!p_game_running) {
+		[[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+		return;
+	}
+	OS *os = OS::get_singleton();
+	NSArray *lines = @[ @"game", _ns(os->get_in_process_session_value("game_log")), _ns(os->get_in_process_session_value("game_scene")), _ns(os->get_in_process_session_value("game_project")) ];
+	[[lines componentsJoinedByString:@"\n"] writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil];
+}
+
+bool ipados_editor_consume_session_marker(List<String> &r_editor_args, String &r_message) {
+	NSString *path = _marker_path();
+	NSString *content = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+	if (!content) {
+		return false;
+	}
+	[[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+	NSArray<NSString *> *lines = [content componentsSeparatedByString:@"\n"];
+	if (lines.count < 4 || ![lines[0] isEqualToString:@"game"] || lines[3].length == 0) {
+		return false;
+	}
+	r_editor_args.clear();
+	r_editor_args.push_back("--path");
+	r_editor_args.push_back(String::utf8(lines[3].UTF8String));
+	r_editor_args.push_back("-e");
+	OS *os = OS::get_singleton();
+	os->set_in_process_session_value("game_log", String::utf8(lines[1].UTF8String));
+	os->set_in_process_session_value("game_scene", String::utf8(lines[2].UTF8String));
+	os->set_in_process_session_value("game_exit_code", "terminated");
+	r_message = "The running project ended unexpectedly: it crashed, iPadOS terminated it (for example because the device ran out of memory), or the app was closed while it was running. The game output up to that point is shown in the Output panel.";
+	os->set_in_process_session_value("game_termination_message", r_message);
+	return true;
+}
+
+#endif // TOOLS_ENABLED
