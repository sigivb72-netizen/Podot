+	// Undo/redo taps are an editor convenience (as in drawing apps); projects handle taps themselves.
+	if (!Engine::get_singleton()->is_editor_hint()) {
+		return;
+	}
+	// Send the editor's own shortcuts (Command+Z / Command+Shift+Z on Apple keyboards).
+	for (int pressed = 1; pressed >= 0; pressed--) {
+		Ref<InputEventKey> ev;
+		ev.instantiate();
+		ev->set_keycode(Key::Z);
+		ev->set_physical_keycode(Key::Z);
+		ev->set_key_label(Key::Z);
+		ev->set_meta_pressed(true);
+		ev->set_shift_pressed(p_action == TouchGestureRecognizer::TAP_REDO);
