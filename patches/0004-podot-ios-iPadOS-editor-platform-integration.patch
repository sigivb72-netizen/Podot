+// Returns true if this touch is reported as a mouse (indirect pointer, or Apple Pencil when
+// pencil_as_mouse is enabled) instead of a screen touch.
+- (BOOL)isPointerTouch:(UITouch *)touch {
+	if (@available(iOS 13.4, *)) {
+		if (touch.type == UITouchTypeIndirectPointer) {
+			return YES;
+		}
+	}
+	if (touch.type == UITouchTypePencil && DisplayServerAppleEmbedded::get_singleton() && DisplayServerAppleEmbedded::get_singleton()->pencil_as_mouse) {
+		return YES;
+	}
+	return NO;
+}
+
+- (Point2)pixelPositionForTouch:(UITouch *)touch {
+	CGPoint point;
+	if (@available(iOS 13.4, *)) {
+		point = [touch preciseLocationInView:self];
+	} else {
+		point = [touch locationInView:self];
+	}
+	return Point2(point.x * self.contentScaleFactor, point.y * self.contentScaleFactor);
+}
+
+- (float)pressureForTouch:(UITouch *)touch {
+	if (touch.type == UITouchTypePencil && touch.maximumPossibleForce > 0) {
+		return touch.force / touch.maximumPossibleForce;
+	}
+	return 1.0;
+}
+
+- (Vector2)tiltForTouch:(UITouch *)touch {
+	if (touch.type != UITouchTypePencil) {
+		return Vector2();
+	}
+	CGFloat alt = [touch altitudeAngle];
+	CGVector azim = [touch azimuthUnitVectorInView:self];
+	return Vector2(azim.dx, azim.dy) * Math::cos(alt);
+}
+
+- (MouseButton)mouseButtonForTouch:(UITouch *)touch event:(UIEvent *)event {
+	if (@available(iOS 13.4, *)) {
+		if (touch.type == UITouchTypeIndirectPointer) {
+			const UIEventButtonMask mask = event.buttonMask;
+			if (mask & UIEventButtonMaskSecondary) {
+				return MouseButton::RIGHT;
+			}
+			if (mask & UIEventButtonMaskForButtonNumber(3)) {
+				return MouseButton::MIDDLE;
+			}
+		}
+	}
+	return MouseButton::LEFT;
+}
