+#pragma once
+
+// Minimal in-app crash reporter. iOS only keeps crash logs in Settings (hard to reach for users) and
+// a sideloaded app has no other channel, so fatal signals and uncaught exceptions are written to a
+// file with a symbolized backtrace and the last "breadcrumb" (what the app was doing). The report is
+// offered to the user at the next launch and saved to the Documents folder (Files app).
+
+// Installs the handlers. Call once, as early as possible.
+void ios_crash_reporter_install();
+
+// Records what the app is doing (async-signal-safe to read; keep it short).
+void ios_crash_reporter_set_breadcrumb(const char *p_text);
+
+// If the previous run crashed: shows the report (with a Copy button) once the UI is up.
+void ios_crash_reporter_present_previous_report();
