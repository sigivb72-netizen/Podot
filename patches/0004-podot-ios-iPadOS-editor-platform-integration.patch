+
+#import "ios_crash_reporter.h"
+
+#import "drivers/apple_embedded/app_delegate_service.h"
+#import "drivers/apple_embedded/godot_view_controller.h"
+
+#import <UIKit/UIKit.h>
+
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <fcntl.h>
+#include <mach-o/dyld.h>
+#include <signal.h>
+#include <string.h>
+#include <unistd.h>
+
+static int crash_fd = -1;
+static char crash_breadcrumbs[8][160];
+static volatile int crash_breadcrumb_next = 0;
+static char crash_header[256];
+static NSString *previous_report = nil;
+
+static const int crash_signals[] = { SIGSEGV, SIGBUS, SIGILL, SIGABRT, SIGFPE, SIGTRAP };
+
+static void _write_str(const char *p_str) {
+	if (crash_fd >= 0 && p_str) {
+		write(crash_fd, p_str, strlen(p_str));
+	}
+}
+
+static void _write_hex(uintptr_t p_value) {
+	char buf[2 + sizeof(uintptr_t) * 2 + 1];
+	int pos = sizeof(buf) - 1;
+	buf[pos] = 0;
+	do {
+		buf[--pos] = "0123456789abcdef"[p_value & 0xf];
+		p_value >>= 4;
+	} while (p_value && pos > 2);
+	buf[--pos] = 'x';
+	buf[--pos] = '0';
+	_write_str(buf + pos);
+}
+
+static void _write_report_body() {
+	_write_str(crash_header);
+	_write_str("\nLast steps (oldest first):\n");
+	for (int i = 0; i < 8; i++) {
+		const char *crumb = crash_breadcrumbs[(crash_breadcrumb_next + i) % 8];
+		if (crumb[0]) {
+			_write_str("  ");
+			_write_str(crumb);
+			_write_str("\n");
+		}
+	}
+	_write_str("Image slide: ");
+	_write_hex((uintptr_t)_dyld_get_image_vmaddr_slide(0));
+	_write_str("\nBacktrace:\n");
+	void *frames[96];
+	int count = backtrace(frames, 96);
+	if (crash_fd >= 0) {
+		backtrace_symbols_fd(frames, count, crash_fd);
+	}
+}
+
+static void _signal_handler(int p_signal, siginfo_t *p_info, void *p_context) {
+	// Restore the default handlers first, so that a crash in here terminates normally.
+	for (int sig : crash_signals) {
+		signal(sig, SIG_DFL);
+	}
+	_write_str("Podot crash report\nSignal: ");
+	_write_str(strsignal(p_signal));
+	_write_str(" at address ");
+	_write_hex((uintptr_t)(p_info ? p_info->si_addr : nullptr));
+	_write_str("\n");
+	_write_report_body();
+	if (crash_fd >= 0) {
+		fsync(crash_fd);
+	}
+	raise(p_signal);
+}
+
+static void _exception_handler(NSException *p_exception) {
+	_write_str("Podot crash report\nUncaught exception: ");
+	_write_str(p_exception.name.UTF8String);
+	_write_str(": ");
+	_write_str(p_exception.reason.UTF8String);
+	_write_str("\nException backtrace:\n");
+	for (NSString *line in p_exception.callStackSymbols) {
+		_write_str(line.UTF8String);
+		_write_str("\n");
+	}
+	_write_report_body();
+	if (crash_fd >= 0) {
+		fsync(crash_fd);
+	}
+}
+
+static NSString *_report_path() {
+	NSArray *paths = NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES);
+	return [[paths firstObject] stringByAppendingPathComponent:@"podot_crash_report.txt"];
+}
+
+void ios_crash_reporter_set_breadcrumb(const char *p_text) {
+	const int slot = crash_breadcrumb_next % 8;
+	strlcpy(crash_breadcrumbs[slot], p_text ? p_text : "", sizeof(crash_breadcrumbs[slot]));
+	crash_breadcrumb_next = (slot + 1) % 8;
+	NSLog(@"[Podot] %s", p_text);
+}
+
+void ios_crash_reporter_install() {
+	NSString *path = _report_path();
+
+	// Pick up the report of the previous run, if any.
+	NSString *content = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+	if (content.length > 0) {
+		previous_report = content;
+		NSArray *docs = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES);
+		NSString *copy = [[docs firstObject] stringByAppendingPathComponent:@"Podot-crash-report.txt"];
+		[content writeToFile:copy atomically:YES encoding:NSUTF8StringEncoding error:nil];
+	}
+
+	crash_fd = open(path.fileSystemRepresentation, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+
+	NSDictionary *info = [[NSBundle mainBundle] infoDictionary];
+	snprintf(crash_header, sizeof(crash_header), "App: %s %s (%s), iOS %s, %s",
+			[info[@"CFBundleName"] UTF8String] ?: "?", [info[@"CFBundleShortVersionString"] UTF8String] ?: "?", [info[@"CFBundleVersion"] UTF8String] ?: "?",
+			[UIDevice currentDevice].systemVersion.UTF8String, [UIDevice currentDevice].model.UTF8String);
+
+	struct sigaction action;
+	memset(&action, 0, sizeof(action));
+	action.sa_sigaction = _signal_handler;
+	action.sa_flags = SA_SIGINFO;
+	sigemptyset(&action.sa_mask);
+	for (int sig : crash_signals) {
+		sigaction(sig, &action, nullptr);
+	}
+	NSSetUncaughtExceptionHandler(&_exception_handler);
+}
+
+static void _present_report(int p_attempt) {
+	UIViewController *vc = GDTAppDelegateService.viewController;
+	if (!vc || !vc.view.window || vc.presentedViewController) {
+		if (p_attempt < 30) {
+			dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+				_present_report(p_attempt + 1);
+			});
+		}
+		return;
+	}
+	NSString *report = previous_report;
+	previous_report = nil;
+	NSString *shown = report.length > 1500 ? [[report substringToIndex:1500] stringByAppendingString:@"\n…"] : report;
+	UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Podot closed unexpectedly last time"
+																   message:[NSString stringWithFormat:@"A report was saved as \"Podot-crash-report.txt\" in the Podot folder of the Files app.\n\n%@", shown]
+															preferredStyle:UIAlertControllerStyleAlert];
+	[alert addAction:[UIAlertAction actionWithTitle:@"Copy Report"
+											  style:UIAlertActionStyleDefault
+											handler:^(UIAlertAction *action) {
+												[UIPasteboard generalPasteboard].string = report;
+											}]];
+	[alert addAction:[UIAlertAction actionWithTitle:@"Close" style:UIAlertActionStyleCancel handler:nil]];
+	[vc presentViewController:alert animated:YES completion:nil];
+}
+
+void ios_crash_reporter_present_previous_report() {
+	if (!previous_report) {
+		return;
+	}
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 4 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+		_present_report(0);
+	});
+}
