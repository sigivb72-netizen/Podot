+#include "project_device_limits.h"
+
+#include "core/io/dir_access.h"
+#include "core/io/file_access.h"
+#include "core/os/os.h"
+
+static void _scan_dir(Ref<DirAccess> &p_da, const String &p_dir, bool p_is_import_cache, ProjectDeviceLimits::ProjectStats &r_stats) {
+	if (r_stats.file_count >= ProjectDeviceLimits::MAX_SCANNED_FILES) {
+		r_stats.truncated = true;
+		return;
+	}
+	if (p_da->change_dir(p_dir) != OK) {
+		return;
+	}
+	Vector<String> subdirs;
+	p_da->list_dir_begin();
+	String name = p_da->get_next();
+	while (!name.is_empty()) {
+		if (name == "." || name == "..") {
+			name = p_da->get_next();
+			continue;
+		}
+		const String path = p_dir.path_join(name);
+		if (p_da->current_is_dir()) {
+			if (!p_is_import_cache && name == ".godot") {
+				const String imported = path.path_join("imported");
+				if (DirAccess::dir_exists_absolute(imported)) {
+					subdirs.push_back("|" + imported); // Marked as import cache.
+				}
+			} else if (p_is_import_cache || !name.begins_with(".")) {
+				subdirs.push_back((p_is_import_cache ? "|" : "") + path);
+			}
+		} else {
+			const int64_t file_size = FileAccess::get_size(path);
+			const uint64_t size = file_size > 0 ? file_size : 0;
+			r_stats.file_count++;
+			if (p_is_import_cache) {
+				r_stats.imported_bytes += size;
+			} else {
+				r_stats.source_bytes += size;
+				if (size > r_stats.largest_file_bytes) {
+					r_stats.largest_file_bytes = size;
+					r_stats.largest_file = path;
+				}
+			}
+			if (r_stats.file_count >= ProjectDeviceLimits::MAX_SCANNED_FILES) {
+				r_stats.truncated = true;
+				break;
+			}
+		}
+		name = p_da->get_next();
+	}
+	p_da->list_dir_end();
+
+	for (const String &subdir : subdirs) {
+		const bool import_cache = subdir.begins_with("|");
+		_scan_dir(p_da, import_cache ? subdir.substr(1) : subdir, import_cache, r_stats);
+	}
+}
+
+ProjectDeviceLimits::ProjectStats ProjectDeviceLimits::scan_project(const String &p_project_path) {
+	ProjectStats stats;
+	Ref<DirAccess> da = DirAccess::create(DirAccess::ACCESS_FILESYSTEM);
+	_scan_dir(da, p_project_path, false, stats);
+	return stats;
+}
+
+ProjectDeviceLimits::DeviceInfo ProjectDeviceLimits::get_device_info(const String &p_project_path) {
+	DeviceInfo info;
+	const Dictionary mem = OS::get_singleton()->get_memory_info();
+	const int64_t physical = mem.get("physical", -1);
+	info.physical_memory = physical > 0 ? physical : 0;
+	Ref<DirAccess> da = DirAccess::open(p_project_path);
+	if (da.is_valid()) {
+		info.free_storage = da->get_space_left();
+	}
+	return info;
+}
+
+String ProjectDeviceLimits::get_warning(const ProjectStats &p_stats, const DeviceInfo &p_device) {
+	PackedStringArray problems;
+
+	if (p_device.physical_memory > 0) {
+		// Imported assets are loaded into RAM (and VRAM, which is shared on mobile devices). Projects
+		// whose assets alone exceed ~60% of the memory are very likely to be killed by the OS.
+		const uint64_t memory_budget = p_device.physical_memory * 6 / 10;
+		const uint64_t asset_bytes = MAX(p_stats.source_bytes, p_stats.imported_bytes);
+		if (asset_bytes > memory_budget) {
+			problems.push_back(vformat(TTR("The project contains %s of assets, but this device only has %s of memory. The editor will likely run out of memory and be terminated by the system while importing or editing it."), String::humanize_size(asset_bytes), String::humanize_size(p_device.physical_memory)));
+		}
+		// A single huge file (e.g. a 3D model or video) must be loaded at once.
+		if (p_stats.largest_file_bytes > p_device.physical_memory / 4) {
+			problems.push_back(vformat(TTR("The file \"%s\" is %s. Importing it may exhaust the memory of this device."), p_stats.largest_file.get_file(), String::humanize_size(p_stats.largest_file_bytes)));
+		}
+	}
+
+	if (p_device.free_storage > 0) {
+		// The first import of a project typically needs about as much space again as its assets.
+		const uint64_t reserve = 512 * 1024 * 1024;
+		const uint64_t needed = p_stats.imported_bytes > 0 ? reserve : p_stats.source_bytes + reserve;
+		if (p_device.free_storage < needed) {
+			problems.push_back(vformat(TTR("Only %s of storage is free. Importing this project needs about %s; imports and saves may fail."), String::humanize_size(p_device.free_storage), String::humanize_size(needed)));
+		}
+	}
+
+	if (p_stats.truncated) {
+		problems.push_back(vformat(TTR("The project contains more than %d files. Scanning it may take a long time and use a lot of memory."), MAX_SCANNED_FILES));
+	}
+
+	if (problems.is_empty()) {
+		return String();
+	}
+	return "- " + String("\n- ").join(problems);
+}
