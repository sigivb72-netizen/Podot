+Error EditorNode::run_game_in_process(const List<String> &p_game_args, const String &p_running_scene) {
+	ERR_FAIL_COND_V(!OS::get_singleton()->is_in_process_instances_enabled(), ERR_UNAVAILABLE);
+	ERR_FAIL_COND_V_MSG(exiting, ERR_BUSY, "The editor is already shutting down.");
+
+	const String log_path = EditorPaths::get_singleton()->get_cache_dir().path_join("in_process_game.log");
+	{
+		// Start from an empty log, so that stale output from a previous run is never shown.
+		Ref<DirAccess> da = DirAccess::create(DirAccess::ACCESS_FILESYSTEM);
+		if (da->file_exists(log_path)) {
+			da->remove(log_path);
+		}
+	}
+
+	List<String> game_args;
+	for (List<String>::ConstIterator itr = p_game_args.begin(); itr != p_game_args.end(); ++itr) {
+		const String &arg = *itr;
+		// The editor (and thus its debugger server) is not running while the game runs, so don't
+		// make the game wait for a debugger connection or watch the editor process.
+		if (arg == "--remote-debug" || arg == "--editor-pid" || arg == "--log-file") {
+			++itr;
+			if (itr == p_game_args.end()) {
+				break;
+			}
+			continue;
+		}
+		game_args.push_back(arg);
+	}
+	game_args.push_back("--log-file");
+	game_args.push_back(log_path);
+
+	List<String> editor_args;
+	for (const String &a : Main::get_forwardable_cli_arguments(Main::CLI_SCOPE_TOOL)) {
+		editor_args.push_back(a);
+	}
+	editor_args.push_back("--path");
+	editor_args.push_back(ProjectSettings::get_singleton()->get_resource_path());
+	editor_args.push_back("-e");
+	if (get_tree()->get_edited_scene_root() && !get_tree()->get_edited_scene_root()->get_scene_file_path().is_empty()) {
+		editor_args.push_back(get_tree()->get_edited_scene_root()->get_scene_file_path());
+	}
+
+	OS *os = OS::get_singleton();
+	os->set_in_process_session_value("game_running", "1");
+	os->set_in_process_session_value("game_log", log_path);
+	os->set_in_process_session_value("game_scene", p_running_scene);
+	os->set_in_process_session_value("game_project", ProjectSettings::get_singleton()->get_resource_path());
+	os->set_in_process_session_value("game_start_ticks", itos(os->get_ticks_msec()));
+
+	os->clear_pending_in_process_instances();
+	os->queue_in_process_instance(game_args);
+	os->queue_in_process_instance(editor_args);
+
+	print_line(vformat("Running the project in-process: the editor will close and reopen when the game quits (log: %s).", log_path));
+
+	// Deferred: this can be called from an editor plugin (EditorInterface.play_main_scene()), which
+	// _exit_editor() unloads.
+	exiting = true;
+	callable_mp(this, &EditorNode::_exit_editor).call_deferred(EXIT_SUCCESS);
+	return OK;
+}
+
+void EditorNode::_show_in_process_game_session_results() {
+	OS *os = OS::get_singleton();
+	const String log_path = os->get_in_process_session_value("game_log");
+	if (log_path.is_empty()) {
+		return;
+	}
+	const String scene = os->get_in_process_session_value("game_scene");
+	const String exit_code = os->get_in_process_session_value("game_exit_code", "0");
+	const uint64_t start_ticks = os->get_in_process_session_value("game_start_ticks", "0").to_int();
+	const uint64_t end_ticks = os->get_in_process_session_value("game_end_ticks", "0").to_int();
+	os->erase_in_process_session_value("game_running");
+	os->erase_in_process_session_value("game_log");
+	os->erase_in_process_session_value("game_scene");
+	os->erase_in_process_session_value("game_exit_code");
+	os->erase_in_process_session_value("game_start_ticks");
+	os->erase_in_process_session_value("game_end_ticks");
+
+	String header = vformat(TTR("--- Game session finished (exit code %s"), exit_code);
+	if (end_ticks > start_ticks) {
+		header += vformat(TTR(", ran for %.1f s"), (end_ticks - start_ticks) / 1000.0);
+	}
+	header += ")";
+	if (!scene.is_empty()) {
+		header += " " + vformat(TTR("Scene: %s"), scene);
+	}
+	header += " ---";
+	print_line(header);
+
+	// Set by the platform when the game did not quit normally (e.g. iPadOS terminated the app).
+	const String termination_message = os->get_in_process_session_value("game_termination_message");
+	if (!termination_message.is_empty()) {
+		os->erase_in_process_session_value("game_termination_message");
+		log->add_message(termination_message, EditorLog::MSG_TYPE_ERROR);
+		EditorToaster::get_singleton()->popup_str(termination_message, EditorToaster::SEVERITY_ERROR);
+	}
+
+	Ref<FileAccess> f = FileAccess::open(log_path, FileAccess::READ);
+	if (f.is_null()) {
+		log->add_message(TTR("The game did not produce a log file."), EditorLog::MSG_TYPE_WARNING);
+		return;
+	}
+	int error_count = 0;
+	int warning_count = 0;
+	while (!f->eof_reached()) {
+		const String line = f->get_line();
+		if (line.is_empty() && f->eof_reached()) {
+			break;
+		}
+		const String stripped = line.strip_edges();
+		EditorLog::MessageType type = EditorLog::MSG_TYPE_STD;
+		if (stripped.begins_with("ERROR:") || stripped.begins_with("SCRIPT ERROR:") || stripped.begins_with("USER ERROR:") || stripped.begins_with("SHADER ERROR:")) {
+			type = EditorLog::MSG_TYPE_ERROR;
+			error_count++;
+		} else if (stripped.begins_with("WARNING:") || stripped.begins_with("USER WARNING:") || stripped.begins_with("SCRIPT WARNING:")) {
+			type = EditorLog::MSG_TYPE_WARNING;
+			warning_count++;
+		}
+		log->add_message(line, type);
+	}
+	log->add_message(vformat(TTR("--- End of game output (%d errors, %d warnings) ---"), error_count, warning_count), EditorLog::MSG_TYPE_EDITOR);
+	editor_dock_manager->open_dock(log, true);
+}
