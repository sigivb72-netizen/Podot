+InProcessGameWindow *InProcessGameWindow::singleton = nullptr;
+
+// InProcessGameView
+
+Vector2 InProcessGameView::_get_pixel_scale() const {
+	const Vector2 s = get_global_transform_with_canvas().get_scale();
+	return Vector2(MAX(s.x, 0.01), MAX(s.y, 0.01));
+}
+
+void InProcessGameView::_notification(int p_what) {
+	switch (p_what) {
+		case NOTIFICATION_INTERNAL_PROCESS: {
+			InProcessGame *game = InProcessGame::get_singleton();
+			if (InProcessGame::is_running() && is_visible_in_tree()) {
+				// The game's root window has the size of this view in pixels, like a real window.
+				game->set_size(Size2i((get_size() * _get_pixel_scale()).round()));
+				// Taps on the game reach it immediately (no wait for a possible two-finger gesture).
+				TouchGestureRecognizer::direct_input_area = Rect2(get_screen_position() - Vector2(get_tree()->get_root()->get_position()), get_size() * _get_pixel_scale());
+			} else {
+				TouchGestureRecognizer::direct_input_area = Rect2();
+			}
+			queue_redraw();
+		} break;
+		case NOTIFICATION_DRAW: {
+			draw_rect(Rect2(Point2(), get_size()), Color(0, 0, 0));
+			if (InProcessGame::is_running()) {
+				Ref<Texture2D> tex = InProcessGame::get_singleton()->get_texture();
+				if (tex.is_valid()) {
+					draw_texture_rect(tex, Rect2(Point2(), get_size()), false);
+				}
+			}
+		} break;
+	}
+}
+
+void InProcessGameView::gui_input(const Ref<InputEvent> &p_event) {
+	if (!InProcessGame::is_running()) {
+		return;
+	}
+	Ref<InputEventMouseButton> mb = p_event;
+	if (mb.is_valid() && mb->is_pressed()) {
+		grab_focus(); // Keyboard input goes to the game after it was touched/clicked.
+	}
+	Ref<InputEventScreenTouch> st = p_event;
+	if (st.is_valid() && st->is_pressed()) {
+		grab_focus();
+	}
+
+	// Convert from this control's coordinates to the game window's pixels.
+	const Vector2 scale = _get_pixel_scale();
+	Ref<InputEvent> ev = p_event->duplicate();
+	Ref<InputEventMouse> mouse = ev;
+	if (mouse.is_valid()) {
+		mouse->set_position(mouse->get_position() * scale);
+		mouse->set_global_position(mouse->get_position());
+		Ref<InputEventMouseMotion> mm = ev;
+		if (mm.is_valid()) {
+			mm->set_relative(mm->get_relative() * scale);
+			mm->set_relative_screen_position(mm->get_relative_screen_position() * scale);
+			mm->set_screen_velocity(mm->get_screen_velocity() * scale);
+			mm->set_velocity(mm->get_velocity() * scale);
+		}
+	}
+	Ref<InputEventScreenTouch> touch = ev;
+	if (touch.is_valid()) {
+		touch->set_position(touch->get_position() * scale);
+	}
+	Ref<InputEventScreenDrag> drag = ev;
+	if (drag.is_valid()) {
+		drag->set_position(drag->get_position() * scale);
+		drag->set_relative(drag->get_relative() * scale);
+		drag->set_relative_screen_position(drag->get_relative_screen_position() * scale);
+		drag->set_screen_velocity(drag->get_screen_velocity() * scale);
+		drag->set_velocity(drag->get_velocity() * scale);
+	}
+	Ref<InputEventGesture> gesture = ev;
+	if (gesture.is_valid()) {
+		gesture->set_position(gesture->get_position() * scale);
+	}
+	accept_event();
+	InProcessGame::get_singleton()->push_input(ev);
+}
+
+InProcessGameView::InProcessGameView() {
+	set_focus_mode(FOCUS_ALL);
+	set_mouse_filter(MOUSE_FILTER_STOP);
+	set_clip_contents(true);
+	set_process_internal(true);
+	set_v_size_flags(SIZE_EXPAND_FILL);
+	set_h_size_flags(SIZE_EXPAND_FILL);
+}
+
+// InProcessGameWindow
+
+void InProcessGameWindow::_notification(int p_what) {
+	switch (p_what) {
+		case NOTIFICATION_THEME_CHANGED: {
+			stop_button->set_button_icon(get_editor_theme_icon(SNAME("Stop")));
+			restart_button->set_button_icon(get_editor_theme_icon(SNAME("Reload")));
+			maximize_button->set_button_icon(get_editor_theme_icon(SNAME("DistractionFree")));
+		} break;
+		case NOTIFICATION_EXIT_TREE: {
+			// The editor is closing (or reloading the project): stop the game first.
+			InProcessGame::stop();
+		} break;
+	}
+}
+
+void InProcessGameWindow::_place_initially() {
+	Window *editor_root = get_parent_visible_window();
+	Size2 area = editor_root ? Size2(editor_root->get_visible_rect().size) : Size2(1280, 720);
+	Size2 game_size(GLOBAL_GET("display/window/size/viewport_width"), GLOBAL_GET("display/window/size/viewport_height"));
+	if (game_size.x <= 0 || game_size.y <= 0) {
+		game_size = Size2(1152, 648);
+	}
+	// About 40% of the editor's width (more for portrait games), keeping the game's aspect ratio.
+	const float aspect = game_size.y / game_size.x;
+	float w = area.x * (aspect > 1.0 ? 0.3 : 0.42);
+	float h = w * aspect + 40 * EDSCALE;
+	if (h > area.y * 0.8) {
+		h = area.y * 0.8;
+		w = (h - 40 * EDSCALE) / aspect;
+	}
+	const Size2i size_i = Size2i(w, h);
+	set_size(size_i);
+	set_position(Point2i(area.x - size_i.x - 16 * EDSCALE, area.y - size_i.y - 60 * EDSCALE).maxi(0));
+}
+
+Error InProcessGameWindow::start(const String &p_scene) {
+	if (InProcessGame::is_running()) {
+		InProcessGame::stop();
+	}
+	scene = p_scene;
+	if (!is_visible()) {
+		if (!maximized) {
+			_place_initially();
+		}
+		show();
+	}
+	set_title(vformat(TTR("Game: %s"), GLOBAL_GET("application/config/name")));
+	status_label->set_text(p_scene.get_file());
+	// The game's window has the size of the view (computed once the window is laid out).
+	const Size2i view_size = view->get_size() == Size2() ? Size2i(get_size().x, MAX(get_size().y - 40 * EDSCALE, 64)) : Size2i(view->get_size());
+	const Error err = InProcessGame::start(p_scene, view_size, EditorNode::get_singleton()->get_tree()->get_root(), callable_mp(this, &InProcessGameWindow::_game_finished));
+	if (err != OK) {
+		hide();
+		return err;
+	}
+	view->grab_focus();
+	return OK;
+}
+
+void InProcessGameWindow::stop() {
+	InProcessGame::stop();
+	hide();
+}
+
+bool InProcessGameWindow::is_running() const {
+	return InProcessGame::is_running();
+}
+
+void InProcessGameWindow::_game_finished() {
+	if (InProcessGame::is_running()) {
+		return; // Restarted meanwhile.
+	}
+	hide();
+	if (EditorRunBar::get_singleton() && EditorRunBar::get_singleton()->is_playing()) {
+		EditorRunBar::get_singleton()->stop_playing();
+	}
+}
+
+void InProcessGameWindow::_stop_pressed() {
+	if (EditorRunBar::get_singleton() && EditorRunBar::get_singleton()->is_playing()) {
+		EditorRunBar::get_singleton()->stop_playing(); // Calls stop() through EditorRun::stop().
+	} else {
+		stop();
+	}
+}
+
+void InProcessGameWindow::_restart_pressed() {
+	if (!scene.is_empty()) {
+		start(scene);
+	}
+}
+
+void InProcessGameWindow::_maximize_toggled(bool p_pressed) {
+	Window *editor_root = get_parent_visible_window();
+	if (p_pressed == maximized || !editor_root) {
+		return;
+	}
+	maximized = p_pressed;
+	if (maximized) {
+		normal_rect = Rect2i(get_position(), get_size());
+		const Size2i area = editor_root->get_visible_rect().size;
+		const int title_height = get_theme_constant(SNAME("title_height"));
+		set_position(Point2i(0, title_height));
+		set_size(Size2i(area.x, area.y - title_height));
+	} else {
+		set_position(normal_rect.position);
+		set_size(normal_rect.size);
+	}
+}
+
+void InProcessGameWindow::_bind_methods() {
+}
+
+InProcessGameWindow::InProcessGameWindow() {
+	singleton = this;
+	set_title(TTR("Game"));
+	set_visible(false);
+	set_wrap_controls(true);
+	set_min_size(Size2i(200, 160) * EDSCALE);
+	set_flag(FLAG_RESIZE_DISABLED, false);
+	connect("close_requested", callable_mp(this, &InProcessGameWindow::_stop_pressed));
+
+	VBoxContainer *vb = memnew(VBoxContainer);
+	vb->set_anchors_and_offsets_preset(Control::PRESET_FULL_RECT);
+	vb->add_theme_constant_override("separation", 0);
+	add_child(vb);
+
+	HBoxContainer *toolbar = memnew(HBoxContainer);
+	vb->add_child(toolbar);
+
+	status_label = memnew(Label);
+	status_label->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+	status_label->set_text_overrun_behavior(TextServer::OVERRUN_TRIM_ELLIPSIS);
+	status_label->set_focus_mode(Control::FOCUS_ACCESSIBILITY);
+	toolbar->add_child(status_label);
+
+	restart_button = memnew(Button);
+	restart_button->set_flat(true);
+	restart_button->set_tooltip_text(TTR("Restart the game"));
+	restart_button->set_accessibility_name(TTRC("Restart"));
+	restart_button->connect(SceneStringName(pressed), callable_mp(this, &InProcessGameWindow::_restart_pressed));
+	toolbar->add_child(restart_button);
+
+	maximize_button = memnew(Button);
+	maximize_button->set_flat(true);
+	maximize_button->set_toggle_mode(true);
+	maximize_button->set_tooltip_text(TTR("Fill the editor / restore the window"));
+	maximize_button->set_accessibility_name(TTRC("Maximize"));
+	maximize_button->connect(SceneStringName(toggled), callable_mp(this, &InProcessGameWindow::_maximize_toggled));
+	toolbar->add_child(maximize_button);
+
+	stop_button = memnew(Button);
