+// MARK: Pointer gestures (hover, scroll, pinch) and pointer shape
+
+- (void)initPointerInput {
+	pointer_touch_button = [NSMapTable weakToStrongObjectsMapTable];
+#if defined(IOS_ENABLED)
+	if (@available(iOS 13.4, *)) {
+		// Mouse / trackpad hover and Apple Pencil hover (on supported iPads).
+		UIHoverGestureRecognizer *hover = [[UIHoverGestureRecognizer alloc] initWithTarget:self action:@selector(handleHover:)];
+		hover.cancelsTouchesInView = NO;
+		[self addGestureRecognizer:hover];
+
+		// Scroll wheel and two-finger trackpad scrolling. No touch types are allowed, so it never
+		// interferes with touches on the screen.
+		UIPanGestureRecognizer *scroll = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(handleScroll:)];
+		scroll.allowedScrollTypesMask = UIScrollTypeMaskAll;
+		scroll.allowedTouchTypes = @[];
+		scroll.cancelsTouchesInView = NO;
+		scroll.maximumNumberOfTouches = 0;
+		[self addGestureRecognizer:scroll];
+
+		// Trackpad pinch. Screen pinches are handled by Godot itself from the raw touches.
+		UIPinchGestureRecognizer *pinch = [[UIPinchGestureRecognizer alloc] initWithTarget:self action:@selector(handlePinch:)];
+		pinch.allowedTouchTypes = @[ @(UITouchTypeIndirectPointer) ];
+		pinch.cancelsTouchesInView = NO;
+		[self addGestureRecognizer:pinch];
+
+		pointer_interaction = [[UIPointerInteraction alloc] initWithDelegate:(id<UIPointerInteractionDelegate>)self];
+		[self addInteraction:pointer_interaction];
+	}
+#endif
+}
+
+#if defined(IOS_ENABLED)
+- (void)handleHover:(UIHoverGestureRecognizer *)recognizer API_AVAILABLE(ios(13.4)) {
+	DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+	if (!ds || pointer_touch_button.count > 0) {
+		return;
+	}
+	if (recognizer.state == UIGestureRecognizerStateBegan || recognizer.state == UIGestureRecognizerStateChanged) {
+		CGPoint point = [recognizer locationInView:self];
+		ds->pointer_motion(Point2(point.x * self.contentScaleFactor, point.y * self.contentScaleFactor), 0.0, Vector2(), false, recognizer.modifierFlags);
+	}
+}
+
+- (void)handleScroll:(UIPanGestureRecognizer *)recognizer API_AVAILABLE(ios(13.4)) {
+	DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+	if (!ds) {
+		return;
+	}
+	if (recognizer.state == UIGestureRecognizerStateBegan) {
+		last_scroll_translation = CGPointZero;
+	}
+	if (recognizer.state == UIGestureRecognizerStateBegan || recognizer.state == UIGestureRecognizerStateChanged) {
+		CGPoint translation = [recognizer translationInView:self];
+		CGPoint delta = CGPointMake(translation.x - last_scroll_translation.x, translation.y - last_scroll_translation.y);
+		last_scroll_translation = translation;
+		CGPoint point = [recognizer locationInView:self];
+		// Content follows the fingers on iPadOS (natural scrolling), Godot expects the scroll direction.
+		ds->pointer_scroll(Point2(point.x * self.contentScaleFactor, point.y * self.contentScaleFactor), Vector2(-delta.x, -delta.y) * self.contentScaleFactor, recognizer.modifierFlags);
+	}
+}
+
+- (void)handlePinch:(UIPinchGestureRecognizer *)recognizer API_AVAILABLE(ios(13.4)) {
+	DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+	if (!ds) {
+		return;
+	}
+	if (recognizer.state == UIGestureRecognizerStateBegan) {
+		last_pinch_scale = 1.0;
+	}
+	if ((recognizer.state == UIGestureRecognizerStateBegan || recognizer.state == UIGestureRecognizerStateChanged) && last_pinch_scale > 0.0) {
+		CGPoint point = [recognizer locationInView:self];
+		ds->pointer_magnify(Point2(point.x * self.contentScaleFactor, point.y * self.contentScaleFactor), recognizer.scale / last_pinch_scale, recognizer.modifierFlags);
+		last_pinch_scale = recognizer.scale;
+	}
+}
+
+- (UIPointerStyle *)pointerInteraction:(UIPointerInteraction *)interaction styleForRegion:(UIPointerRegion *)region API_AVAILABLE(ios(13.4)) {
+	DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+	if (!ds) {
+		return nil;
+	}
+	switch (ds->cursor_get_shape()) {
+		case DisplayServerEnums::CURSOR_IBEAM:
+			return [UIPointerStyle styleWithShape:[UIPointerShape beamWithPreferredLength:20 axis:UIAxisVertical] constrainedAxes:UIAxisNeither];
+		case DisplayServerEnums::CURSOR_VSIZE:
+		case DisplayServerEnums::CURSOR_VSPLIT:
+			return [UIPointerStyle styleWithShape:[UIPointerShape beamWithPreferredLength:16 axis:UIAxisHorizontal] constrainedAxes:UIAxisNeither];
+		case DisplayServerEnums::CURSOR_HSIZE:
+		case DisplayServerEnums::CURSOR_HSPLIT:
+			return [UIPointerStyle styleWithShape:[UIPointerShape beamWithPreferredLength:16 axis:UIAxisVertical] constrainedAxes:UIAxisNeither];
+		case DisplayServerEnums::CURSOR_CROSS:
+		case DisplayServerEnums::CURSOR_MOVE:
+		case DisplayServerEnums::CURSOR_DRAG:
+			return [UIPointerStyle styleWithShape:[UIPointerShape shapeWithRoundedRect:CGRectMake(0, 0, 6, 6) cornerRadius:3] constrainedAxes:UIAxisNeither];
+		default:
+			return nil; // System default pointer.
+	}
+}
+
+- (UIPointerRegion *)pointerInteraction:(UIPointerInteraction *)interaction regionForRequest:(UIPointerRegionRequest *)request defaultRegion:(UIPointerRegion *)defaultRegion API_AVAILABLE(ios(13.4)) {
+	// A small region around the pointer, identified by the cursor shape, so that the style is
+	// re-evaluated whenever Godot changes the cursor shape.
+	DisplayServerAppleEmbedded *ds = DisplayServerAppleEmbedded::get_singleton();
+	const int shape = ds ? (int)ds->cursor_get_shape() : 0;
+	return [UIPointerRegion regionWithRect:CGRectMake(request.location.x - 1, request.location.y - 1, 2, 2) identifier:@(shape)];
+}
+#endif
+
+- (void)pointerShapeChanged {
+#if defined(IOS_ENABLED)
+	if (@available(iOS 13.4, *)) {
+		[(UIPointerInteraction *)pointer_interaction invalidate];
+	}
+#endif
+}
+
+- (void)releaseRenderingLayer {
+	if (self.renderingLayer) {
+		[self.renderingLayer removeFromSuperlayer];
+		self.renderingLayer = nil;
 	}
+	self.delegateDidFinishSetUp = NO;
 	[self clearTouches];
+	[pointer_touch_button removeAllObjects];
 }
 
