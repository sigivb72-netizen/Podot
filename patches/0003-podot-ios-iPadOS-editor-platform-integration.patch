+#import "ios_document_picker.h"
+
+#include "core/os/os.h"
+#include "core/string/print_string.h"
+#include "core/variant/typed_array.h"
+#include "core/variant/dictionary.h"
+#import "drivers/apple_embedded/app_delegate_service.h"
+#import "drivers/apple_embedded/godot_view_controller.h"
+
+#import <UIKit/UIKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+static NSString *const GDTBookmarksDefaultsKey = @"godot_security_scoped_bookmarks";
+
+// URLs currently being accessed (kept for the whole app lifetime).
+static NSMutableArray<NSURL *> *gdt_accessed_urls = nil;
+
+static void _gdt_access_url(NSURL *p_url) {
+	if (!gdt_accessed_urls) {
+		gdt_accessed_urls = [NSMutableArray array];
+	}
+	for (NSURL *url in gdt_accessed_urls) {
+		if ([url.path isEqualToString:p_url.path]) {
+			return;
+		}
+	}
+	if ([p_url startAccessingSecurityScopedResource]) {
+		[gdt_accessed_urls addObject:p_url];
+	}
+}
+
+static void _gdt_store_bookmark(NSURL *p_url) {
+	NSError *error = nil;
+	NSData *data = [p_url bookmarkDataWithOptions:0 includingResourceValuesForKeys:nil relativeToURL:nil error:&error];
+	if (!data) {
+		print_verbose(vformat("Unable to create a bookmark for \"%s\": %s", String::utf8(p_url.path.UTF8String), String::utf8(error.localizedDescription.UTF8String)));
+		return;
+	}
+	NSMutableDictionary *bookmarks = [[[NSUserDefaults standardUserDefaults] dictionaryForKey:GDTBookmarksDefaultsKey] mutableCopy];
+	if (!bookmarks) {
+		bookmarks = [NSMutableDictionary dictionary];
+	}
+	bookmarks[p_url.path] = data;
+	[[NSUserDefaults standardUserDefaults] setObject:bookmarks forKey:GDTBookmarksDefaultsKey];
+}
+
+void ios_document_picker_restore_bookmarks() {
+	NSDictionary *bookmarks = [[NSUserDefaults standardUserDefaults] dictionaryForKey:GDTBookmarksDefaultsKey];
+	if (!bookmarks) {
+		return;
+	}
+	NSMutableDictionary *updated = [NSMutableDictionary dictionary];
+	for (NSString *path in bookmarks) {
+		NSData *data = bookmarks[path];
+		BOOL stale = NO;
+		NSError *error = nil;
+		NSURL *url = [NSURL URLByResolvingBookmarkData:data options:0 relativeToURL:nil bookmarkDataIsStale:&stale error:&error];
+		if (!url) {
+			// The location is gone (e.g. the external drive was removed); keep the bookmark for later.
+			updated[path] = data;
+			continue;
+		}
+		_gdt_access_url(url);
+		if (stale) {
+			NSData *fresh = [url bookmarkDataWithOptions:0 includingResourceValuesForKeys:nil relativeToURL:nil error:nil];
+			updated[url.path] = fresh ? fresh : data;
+		} else {
+			updated[url.path] = data;
+		}
+	}
+	[[NSUserDefaults standardUserDefaults] setObject:updated forKey:GDTBookmarksDefaultsKey];
+}
+
+Vector<String> ios_document_picker_get_bookmarked_paths() {
+	Vector<String> ret;
+	NSDictionary *bookmarks = [[NSUserDefaults standardUserDefaults] dictionaryForKey:GDTBookmarksDefaultsKey];
+	for (NSString *path in bookmarks) {
+		ret.push_back(String::utf8(path.UTF8String));
+	}
+	return ret;
+}
+
+@interface GDTDocumentPickerDelegate : NSObject <UIDocumentPickerDelegate> {
+@public
+	Callable callback;
+	BOOL options_in_callback;
+}
+@end
+
+static GDTDocumentPickerDelegate *gdt_active_picker_delegate = nil;
+
+@implementation GDTDocumentPickerDelegate
+
+- (void)finishWithStatus:(bool)p_status paths:(const Vector<String> &)p_paths {
+	if (callback.is_valid()) {
+		if (options_in_callback) {
+			callback.call_deferred(p_status, p_paths, 0, Dictionary());
+		} else {
+			callback.call_deferred(p_status, p_paths, 0);
+		}
+	}
+	gdt_active_picker_delegate = nil;
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
+	Vector<String> paths;
+	for (NSURL *url in urls) {
+		_gdt_access_url(url);
+		_gdt_store_bookmark(url);
+		paths.push_back(String::utf8(url.path.UTF8String));
+	}
+	[self finishWithStatus:!paths.is_empty() paths:paths];
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+	[self finishWithStatus:false paths:Vector<String>()];
+}
+
+@end
+
+static NSArray<UTType *> *_gdt_content_types(DisplayServerEnums::FileDialogMode p_mode, const Vector<String> &p_filters) API_AVAILABLE(ios(14.0)) {
+	if (p_mode == DisplayServerEnums::FILE_DIALOG_MODE_OPEN_DIR) {
+		return @[ UTTypeFolder ];
+	}
+	NSMutableArray<UTType *> *types = [NSMutableArray array];
+	bool any = p_filters.is_empty();
+	for (const String &filter : p_filters) {
+		// Filters are formatted as "*.png, *.jpg ; Description" (the description is optional).
+		const String patterns = filter.get_slicec(';', 0);
+		for (const String &pattern : patterns.split(",", false)) {
+			const String ext = pattern.strip_edges().trim_prefix("*.");
+			if (ext.is_empty() || ext == "*") {
+				any = true;
+				continue;
+			}
+			UTType *type = [UTType typeWithFilenameExtension:[NSString stringWithUTF8String:ext.utf8().get_data()]];
+			if (type) {
+				[types addObject:type];
+			}
+		}
+	}
+	if (any || types.count == 0) {
+		[types addObject:UTTypeItem];
+	}
+	if (p_mode == DisplayServerEnums::FILE_DIALOG_MODE_OPEN_ANY) {
+		[types addObject:UTTypeFolder];
+	}
+	return types;
+}
+
+Error ios_document_picker_show(const String &p_title, const String &p_current_directory, DisplayServerEnums::FileDialogMode p_mode, const Vector<String> &p_filters, const Callable &p_callback, bool p_options_in_callback) {
+	if (@available(iOS 14.0, *)) {
+		ERR_FAIL_COND_V_MSG(p_mode == DisplayServerEnums::FILE_DIALOG_MODE_SAVE_FILE, ERR_UNAVAILABLE, "Saving through the system document picker is not supported.");
+		ERR_FAIL_COND_V_MSG(gdt_active_picker_delegate != nil, ERR_BUSY, "A document picker is already open.");
+
+		UIDocumentPickerViewController *picker = [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:_gdt_content_types(p_mode, p_filters) asCopy:NO];
+		picker.allowsMultipleSelection = p_mode == DisplayServerEnums::FILE_DIALOG_MODE_OPEN_FILES;
+		picker.shouldShowFileExtensions = YES;
+		if (!p_current_directory.is_empty()) {
+			picker.directoryURL = [NSURL fileURLWithPath:[NSString stringWithUTF8String:p_current_directory.utf8().get_data()] isDirectory:YES];
+		}
+		if (!p_title.is_empty()) {
+			picker.title = [NSString stringWithUTF8String:p_title.utf8().get_data()];
+		}
+
+		GDTDocumentPickerDelegate *delegate = [[GDTDocumentPickerDelegate alloc] init];
+		delegate->callback = p_callback;
+		delegate->options_in_callback = p_options_in_callback;
+		gdt_active_picker_delegate = delegate; // UIDocumentPickerViewController only keeps a weak reference.
+		picker.delegate = delegate;
+
+		[GDTAppDelegateService.viewController presentViewController:picker animated:YES completion:nil];
+		return OK;
+	}
+	return ERR_UNAVAILABLE;
+}
