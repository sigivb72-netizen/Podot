+// Mouse, trackpad and Apple Pencil support for the embedded Apple platforms.
+// UIKit reports these devices through UITouch (UITouchTypeIndirectPointer, UITouchTypePencil) and
+// gesture recognizers; GDTView forwards them here and they are turned into regular Godot mouse
+// events, so that desktop-oriented UIs (such as the editor) work with them as on desktop.
+
+#import "display_server_apple_embedded.h"
+
+#include "core/input/input.h"
+#import "drivers/apple_embedded/app_delegate_service.h"
+#import "drivers/apple_embedded/godot_view_apple_embedded.h"
+#import "drivers/apple_embedded/godot_view_controller.h"
+
+#import <GameController/GameController.h>
+#import <UIKit/UIKit.h>
+
+void DisplayServerAppleEmbedded::_apply_modifiers(const Ref<InputEventWithModifiers> &p_event, NSInteger p_modifier) const {
+	if (@available(iOS 13.4, *)) {
+		p_event->set_shift_pressed(p_modifier & UIKeyModifierShift);
+		p_event->set_ctrl_pressed(p_modifier & UIKeyModifierControl);
+		p_event->set_alt_pressed(p_modifier & UIKeyModifierAlternate);
+		p_event->set_meta_pressed(p_modifier & UIKeyModifierCommand);
+	}
+}
+
+void DisplayServerAppleEmbedded::pointer_motion(const Point2 &p_position, float p_pressure, const Vector2 &p_tilt, bool p_pen, NSInteger p_modifier) {
+	const Point2i previous = mouse_position;
+	mouse_position = p_position;
+
+	Ref<InputEventMouseMotion> ev;
+	ev.instantiate();
+	_apply_modifiers(ev, p_modifier);
+	ev->set_button_mask(mouse_button_mask);
+	ev->set_position(p_position);
+	ev->set_global_position(p_position);
+	ev->set_relative(p_position - Point2(previous));
+	ev->set_relative_screen_position(ev->get_relative());
+	ev->set_pressure(p_pressure);
+	ev->set_tilt(p_tilt);
+	if (Input::get_singleton()) {
+		ev->set_velocity(Input::get_singleton()->get_last_mouse_velocity());
+		ev->set_screen_velocity(ev->get_velocity());
+	}
+	perform_event(ev);
+}
+
+void DisplayServerAppleEmbedded::pointer_button(const Point2 &p_position, MouseButton p_button, bool p_pressed, bool p_double_click, float p_pressure, NSInteger p_modifier) {
+	mouse_position = p_position;
+	if (p_pressed) {
+		mouse_button_mask.set_flag(mouse_button_to_mask(p_button));
+	} else {
+		mouse_button_mask.clear_flag(mouse_button_to_mask(p_button));
+	}
+
+	Ref<InputEventMouseButton> ev;
+	ev.instantiate();
+	_apply_modifiers(ev, p_modifier);
+	ev->set_button_index(p_button);
+	ev->set_pressed(p_pressed);
+	ev->set_double_click(p_double_click && p_pressed);
+	ev->set_button_mask(mouse_button_mask);
+	ev->set_position(p_position);
+	ev->set_global_position(p_position);
+	perform_event(ev);
+}
+
+void DisplayServerAppleEmbedded::pointer_release_all(const Point2 &p_position, NSInteger p_modifier) {
+	const MouseButton buttons[] = { MouseButton::LEFT, MouseButton::RIGHT, MouseButton::MIDDLE };
+	for (MouseButton button : buttons) {
+		if (mouse_button_mask.has_flag(mouse_button_to_mask(button))) {
+			pointer_button(p_position, button, false, false, 0.0, p_modifier);
+		}
+	}
+}
+
+void DisplayServerAppleEmbedded::pointer_scroll(const Point2 &p_position, const Vector2 &p_delta, NSInteger p_modifier) {
+	mouse_position = p_position;
+
+	// Same scale as precise (trackpad) scrolling on macOS.
+	Ref<InputEventPanGesture> ev;
+	ev.instantiate();
+	_apply_modifiers(ev, p_modifier);
+	ev->set_position(p_position);
+	ev->set_delta(p_delta * 0.03);
+	perform_event(ev);
+}
+
+void DisplayServerAppleEmbedded::pointer_magnify(const Point2 &p_position, float p_factor, NSInteger p_modifier) {
+	Ref<InputEventMagnifyGesture> ev;
+	ev.instantiate();
+	_apply_modifiers(ev, p_modifier);
+	ev->set_position(p_position);
+	ev->set_factor(p_factor);
+	perform_event(ev);
+}
+
+Point2i DisplayServerAppleEmbedded::mouse_get_position() const {
+	return mouse_position;
+}
+
+BitField<MouseButtonMask> DisplayServerAppleEmbedded::mouse_get_button_state() const {
+	return mouse_button_mask;
+}
+
+void DisplayServerAppleEmbedded::cursor_set_shape(DisplayServerEnums::CursorShape p_shape) {
+	ERR_FAIL_INDEX(p_shape, DisplayServerEnums::CURSOR_MAX);
+	if (cursor_shape == p_shape) {
+		return;
+	}
+	cursor_shape = p_shape;
+#if defined(IOS_ENABLED)
+	[GDTAppDelegateService.viewController.godotView pointerShapeChanged];
+#endif
+}
+
+DisplayServerEnums::CursorShape DisplayServerAppleEmbedded::cursor_get_shape() const {
+	return cursor_shape;
+}
+
+void DisplayServerAppleEmbedded::set_hardware_keyboard_connection_change_callback(const Callable &p_callable) {
+	hardware_keyboard_connection_change_callback = p_callable;
+
+	if (@available(iOS 14.0, *)) {
+		if (!hardware_keyboard_observer_connect) {
+			hardware_keyboard_observer_connect = [[NSNotificationCenter defaultCenter]
+					addObserverForName:GCKeyboardDidConnectNotification
+								object:nil
+								 queue:[NSOperationQueue mainQueue]
+							usingBlock:^(NSNotification *notification) {
+								if (DisplayServerAppleEmbedded::get_singleton()) {
+									DisplayServerAppleEmbedded::get_singleton()->hardware_keyboard_connection_changed(true);
+								}
+							}];
+			hardware_keyboard_observer_disconnect = [[NSNotificationCenter defaultCenter]
+					addObserverForName:GCKeyboardDidDisconnectNotification
+								object:nil
+								 queue:[NSOperationQueue mainQueue]
+							usingBlock:^(NSNotification *notification) {
+								if (DisplayServerAppleEmbedded::get_singleton()) {
+									DisplayServerAppleEmbedded::get_singleton()->hardware_keyboard_connection_changed(false);
+								}
+							}];
+		}
+	}
+}
+
+void DisplayServerAppleEmbedded::hardware_keyboard_connection_changed(bool p_connected) {
+	if (hardware_keyboard_connection_change_callback.is_valid()) {
+		hardware_keyboard_connection_change_callback.call_deferred(p_connected);
+	}
+}
