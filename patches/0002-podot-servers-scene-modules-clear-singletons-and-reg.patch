+#pragma once
+
+#include "core/input/input_event.h"
+#include "core/templates/hash_set.h"
+#include "core/templates/list.h"
+#include "core/templates/pair.h"
+#include "core/templates/rid.h"
+#include "core/variant/callable.h"
+
+class Node;
+class SceneTree;
+class Texture2D;
+class Window;
+
+// Runs a project's scene in a second SceneTree inside the editor process, next to the editor
+// (the iPadOS editor can't start a game process). The game's root window renders off-screen; the
+// editor shows its texture in a floating window and forwards input to it.
+//
+// While game code runs (loading, input, physics and process frames), the engine is switched to
+// "game mode": Engine::is_editor_hint() is false and scripting is enabled, so the project's scripts
+// get real instances and behave as in a running game. Everything else runs in editor mode.
+class InProcessGame {
+	static InProcessGame *singleton;
+
+	SceneTree *tree = nullptr;
+	bool quit_requested = false;
+	bool stopping = false;
+	int exit_code = 0;
+	double start_ticks = 0;
+	Callable finished_callback;
+
+	// Editor state saved while the game runs.
+	bool saved_low_processor_mode = false;
+	HashSet<RID> paused_spaces_2d;
+	HashSet<RID> paused_spaces_3d;
+	List<StringName> added_actions;
+	List<Pair<StringName, Ref<InputEvent>>> added_action_events;
+	List<StringName> autoload_globals;
+
+	void _pause_host_physics(Node *p_node);
+	void _merge_project_input_map();
+	void _restore_input_map();
+	void _load_autoloads();
+
+public:
+	// Switches the engine to game mode while a game runs (no-op otherwise).
+	class Scope {
+		bool active = false;
+		bool prev_editor_hint = false;
+		bool prev_scripting = false;
+
+	public:
+		Scope();
+		~Scope();
+	};
+
+	static InProcessGame *get_singleton() { return singleton; }
+	static bool is_running() { return singleton && singleton->tree; }
+
+	// Starts p_scene (a scene path). p_host_root: the editor's root, whose physics spaces are paused
+	// while the game runs. p_finished is called (deferred) when the game quits by itself.
+	static Error start(const String &p_scene, const Size2i &p_size, Node *p_host_root, const Callable &p_finished);
+	static void stop();
+
+	SceneTree *get_tree() const { return tree; }
+	Window *get_root() const;
+	Ref<Texture2D> get_texture() const;
+	void set_size(const Size2i &p_size);
+	void push_input(const Ref<InputEvent> &p_event);
+	int get_exit_code() const { return exit_code; }
+
+	// Called by Main::iteration().
+	static void physics_frame(double p_step);
+	static void process_frame(double p_step);
+};
