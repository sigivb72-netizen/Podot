diff --git a/drivers/metal/rendering_device_driver_metal.cpp b/drivers/metal/rendering_device_driver_metal.cpp
index 90dae10..6b481f1 100644
--- a/drivers/metal/rendering_device_driver_metal.cpp
+++ b/drivers/metal/rendering_device_driver_metal.cpp
@@ -2754,6 +2754,10 @@ RenderingDeviceDriverMetal::RenderingDeviceDriverMetal(RenderingContextDriverMet
 
 RenderingDeviceDriverMetal::~RenderingDeviceDriverMetal() {
 	for (KeyValue<SHA256Digest, ShaderCacheEntry *> &kv : _shader_cache) {
+		// A library that outlives the driver must not touch the cache when it is released later.
+		if (std::shared_ptr<MDLibrary> library = kv.value->library.lock()) {
+			library->detach_cache_entry();
+		}
 		memdelete(kv.value);
 	}
 
@@ -2893,7 +2897,18 @@ Error RenderingDeviceDriverMetal::_initialize(uint32_t p_device_index, uint32_t
 	}
 
 	// The Metal renderer requires Apple4 family. This is 2017 era A11 chips and newer.
+#if TARGET_OS_SIMULATOR
+	// Simulators on virtualized hosts (CI) report an old GPU family. Keep going there: Simulator
+	// builds with Metal are only used to test the engine (see `simulator_metal`), and features the
+	// simulated GPU lacks only produce rendering errors.
+	const bool gpu_family_too_old = false;
 	if (device_properties->features.highestFamily < MTL::GPUFamilyApple4) {
+		WARN_PRINT("The Simulator GPU does not meet the Metal renderer's requirements; rendering may be incorrect.");
+	}
+#else
+	const bool gpu_family_too_old = device_properties->features.highestFamily < MTL::GPUFamilyApple4;
+#endif
+	if (gpu_family_too_old) {
 		String error_string = vformat("Your Apple GPU does not support the following features, which are required to use Metal-based renderers in Godot:\n\n");
 		if (!device_properties->features.imageCubeArray) {
 			error_string += "- No support for image cube arrays.\n";
diff --git a/drivers/metal/rendering_device_driver_metal3.cpp b/drivers/metal/rendering_device_driver_metal3.cpp
index 1fbd16f..cb1be19 100644
--- a/drivers/metal/rendering_device_driver_metal3.cpp
+++ b/drivers/metal/rendering_device_driver_metal3.cpp
@@ -84,6 +84,18 @@ RenderingDeviceDriverMetal::RenderingDeviceDriverMetal(RenderingContextDriverMet
 }
 
 RenderingDeviceDriverMetal::~RenderingDeviceDriverMetal() {
+	// Wait for the GPU to finish everything that was submitted: the completion and scheduling
+	// handlers of in-flight command buffers reference fences and surfaces that are freed with the
+	// driver. This matters when the driver is destroyed while the app keeps running (the engine
+	// being set up again in the same process), unlike at process exit.
+	if (device_queue.get()) {
+		MTL::CommandBuffer *drain = device_queue->commandBuffer();
+		if (drain) {
+			drain->commit();
+			drain->waitUntilCompleted();
+		}
+	}
+
 	for (MDCommandBuffer *cb : command_buffers) {
 		memdelete(cb);
 	}
