+InProcessGame *InProcessGame::singleton = nullptr;
+
+InProcessGame::Scope::Scope() {
+	if (!InProcessGame::is_running() && !(singleton && singleton->stopping)) {
+		return;
+	}
+	active = true;
+	prev_editor_hint = Engine::get_singleton()->is_editor_hint();
+	prev_scripting = ScriptServer::is_scripting_enabled();
+	Engine::get_singleton()->set_editor_hint(false);
+	ScriptServer::set_scripting_enabled(true);
+}
+
+InProcessGame::Scope::~Scope() {
+	if (!active) {
+		return;
+	}
+	Engine::get_singleton()->set_editor_hint(prev_editor_hint);
+	ScriptServer::set_scripting_enabled(prev_scripting);
+}
+
+Window *InProcessGame::get_root() const {
+	return tree ? tree->get_root() : nullptr;
+}
+
+Ref<Texture2D> InProcessGame::get_texture() const {
+	Window *root = get_root();
+	if (!root) {
+		return Ref<Texture2D>();
+	}
+	return root->get_texture();
+}
+
+void InProcessGame::set_size(const Size2i &p_size) {
+	Window *root = get_root();
+	if (root && p_size.x > 0 && p_size.y > 0 && root->get_size() != p_size) {
+		Scope scope;
+		root->set_size(p_size);
+	}
+}
+
+void InProcessGame::push_input(const Ref<InputEvent> &p_event) {
+	Window *root = get_root();
+	if (!root || p_event.is_null() || quit_requested) {
+		return;
+	}
+	Scope scope;
+	root->push_input(p_event);
+}
+
+void InProcessGame::_pause_host_physics(Node *p_node) {
+	Viewport *vp = Object::cast_to<Viewport>(p_node);
+	if (vp) {
+#ifndef PHYSICS_2D_DISABLED
+		Ref<World2D> w2d = vp->find_world_2d();
+		if (w2d.is_valid() && !paused_spaces_2d.has(w2d->get_space()) && PhysicsServer2D::get_singleton()->space_is_active(w2d->get_space())) {
+			paused_spaces_2d.insert(w2d->get_space());
+			PhysicsServer2D::get_singleton()->space_set_active(w2d->get_space(), false);
+		}
+#endif
+#if !defined(_3D_DISABLED) && !defined(PHYSICS_3D_DISABLED)
+		Ref<World3D> w3d = vp->find_world_3d();
+		if (w3d.is_valid() && !paused_spaces_3d.has(w3d->get_space()) && PhysicsServer3D::get_singleton()->space_is_active(w3d->get_space())) {
+			paused_spaces_3d.insert(w3d->get_space());
+			PhysicsServer3D::get_singleton()->space_set_active(w3d->get_space(), false);
+		}
+#endif
+	}
+	for (int i = 0; i < p_node->get_child_count(); i++) {
+		_pause_host_physics(p_node->get_child(i));
+	}
+}
+
+void InProcessGame::_merge_project_input_map() {
+	// The editor's InputMap has the built-in actions (InputMap::load_default()); add the project's
+	// actions and events (as InputMap::load_from_project_settings() does for a game), and remember
+	// them to remove them when the game stops.
+	InputMap *im = InputMap::get_singleton();
+	List<PropertyInfo> pinfo;
+	ProjectSettings::get_singleton()->get_property_list(&pinfo);
+	for (const PropertyInfo &pi : pinfo) {
+		if (!pi.name.begins_with("input/")) {
+			continue;
+		}
+		const StringName name = pi.name.substr(pi.name.find_char('/') + 1);
+		Dictionary action = GLOBAL_GET(pi.name);
+		if (!action.has("events")) {
+			continue;
+		}
+		if (!im->has_action(name)) {
+			im->add_action(name, action.has("deadzone") ? (float)action["deadzone"] : InputMap::DEFAULT_DEADZONE);
+			added_actions.push_back(name);
+		}
+		Array events = action["events"];
+		for (int i = 0; i < events.size(); i++) {
+			Ref<InputEvent> ev = events[i];
+			if (ev.is_null() || im->action_has_event(name, ev)) {
+				continue;
+			}
+			im->action_add_event(name, ev);
+			if (!added_actions.find(name)) {
+				added_action_events.push_back(Pair<StringName, Ref<InputEvent>>(name, ev));
+			}
+		}
+	}
+}
+
+void InProcessGame::_restore_input_map() {
+	InputMap *im = InputMap::get_singleton();
+	for (const Pair<StringName, Ref<InputEvent>> &E : added_action_events) {
+		if (im->has_action(E.first) && im->action_has_event(E.first, E.second)) {
+			im->action_erase_event(E.first, E.second);
+		}
+	}
+	for (const StringName &E : added_actions) {
+		if (im->has_action(E)) {
+			im->erase_action(E);
+		}
+	}
+	added_actions.clear();
+	added_action_events.clear();
+}
+
+void InProcessGame::_load_autoloads() {
+	// Same as Main::start() for a game.
+	const HashMap<StringName, ProjectSettings::AutoloadInfo> &autoloads = ProjectSettings::get_singleton()->get_autoload_list();
+	List<Node *> to_add;
+	for (const KeyValue<StringName, ProjectSettings::AutoloadInfo> &E : autoloads) {
+		const ProjectSettings::AutoloadInfo &info = E.value;
+		Node *n = nullptr;
+		const String path = ResourceUID::ensure_path(info.path);
+		if (ResourceLoader::get_resource_type(path) == "PackedScene") {
+			Ref<PackedScene> scn = ResourceLoader::load(path);
+			if (scn.is_valid()) {
+				n = scn->instantiate();
+			}
+		} else {
+			Ref<Script> script_res = ResourceLoader::load(path);
+			if (script_res.is_valid() && ClassDB::is_parent_class(script_res->get_instance_base_type(), "Node")) {
+				n = Object::cast_to<Node>(ClassDB::instantiate(script_res->get_instance_base_type()));
+				if (n) {
+					n->set_script(script_res);
+				}
+			}
+		}
+		ERR_CONTINUE_MSG(!n, vformat("Failed to instantiate an autoload: %s.", info.path));
+		n->set_name(info.name);
+		to_add.push_back(n);
+		if (info.is_singleton) {
+			for (int i = 0; i < ScriptServer::get_language_count(); i++) {
+				ScriptServer::get_language(i)->add_named_global_constant(info.name, n);
+			}
+			autoload_globals.push_back(info.name);
+		}
+	}
+	for (Node *E : to_add) {
+		tree->get_root()->add_child(E);
+	}
+}
+
+Error InProcessGame::start(const String &p_scene, const Size2i &p_size, Node *p_host_root, const Callable &p_finished) {
+	ERR_FAIL_COND_V_MSG(is_running(), ERR_ALREADY_IN_USE, "A game is already running in the editor.");
+	if (!singleton) {
+		singleton = memnew(InProcessGame);
+	}
+	InProcessGame *g = singleton;
+	g->quit_requested = false;
+	g->stopping = false;
+	g->exit_code = 0;
+	g->finished_callback = p_finished;
+	g->start_ticks = OS::get_singleton()->get_ticks_msec();
+
+	// Run any pending editor work in editor mode before switching.
+	MessageQueue::get_singleton()->flush();
+
+	// The game needs a frame every frame (the editor otherwise only redraws on changes).
+	g->saved_low_processor_mode = OS::get_singleton()->is_in_low_processor_usage_mode();
+	OS::get_singleton()->set_low_processor_usage_mode(false);
+
+	// Editor scenes must not be simulated while the physics servers run for the game.
+	if (p_host_root) {
+		g->_pause_host_physics(p_host_root);
+	}
+#ifndef PHYSICS_2D_DISABLED
+	PhysicsServer2D::get_singleton()->set_active(true);
+#endif
+#ifndef PHYSICS_3D_DISABLED
+	PhysicsServer3D::get_singleton()->set_active(true);
+#endif
+	g->_merge_project_input_map();
+
+	// Create the tree in game mode (SceneTree reads game settings when constructed).
+	const bool prev_hint = Engine::get_singleton()->is_editor_hint();
+	const bool prev_scripting = ScriptServer::is_scripting_enabled();
+	Engine::get_singleton()->set_editor_hint(false);
+	ScriptServer::set_scripting_enabled(true);
+
+	g->tree = memnew(SceneTree);
+	Window *root = g->tree->get_root();
+	root->set_offscreen_root(true);
+	root->set_size(p_size.x > 0 && p_size.y > 0 ? p_size : Size2i(GLOBAL_GET("display/window/size/viewport_width"), GLOBAL_GET("display/window/size/viewport_height")));
+	root->set_embedding_subwindows(true);
+
+	// Window stretch and canvas settings, as in Main::start() for a game.
+	{
+		const String stretch_mode = GLOBAL_GET("display/window/stretch/mode");
+		const String stretch_aspect = GLOBAL_GET("display/window/stretch/aspect");
+		const String stretch_scale_mode = GLOBAL_GET("display/window/stretch/scale_mode");
+		Window::ContentScaleMode cs_sm = Window::CONTENT_SCALE_MODE_DISABLED;
+		if (stretch_mode == "canvas_items") {
+			cs_sm = Window::CONTENT_SCALE_MODE_CANVAS_ITEMS;
+		} else if (stretch_mode == "viewport") {
+			cs_sm = Window::CONTENT_SCALE_MODE_VIEWPORT;
+		}
+		Window::ContentScaleAspect cs_aspect = Window::CONTENT_SCALE_ASPECT_IGNORE;
+		if (stretch_aspect == "keep") {
+			cs_aspect = Window::CONTENT_SCALE_ASPECT_KEEP;
+		} else if (stretch_aspect == "keep_width") {
+			cs_aspect = Window::CONTENT_SCALE_ASPECT_KEEP_WIDTH;
+		} else if (stretch_aspect == "keep_height") {
+			cs_aspect = Window::CONTENT_SCALE_ASPECT_KEEP_HEIGHT;
+		} else if (stretch_aspect == "expand") {
+			cs_aspect = Window::CONTENT_SCALE_ASPECT_EXPAND;
+		}
+		root->set_content_scale_mode(cs_sm);
+		root->set_content_scale_aspect(cs_aspect);
+		root->set_content_scale_stretch(stretch_scale_mode == "integer" ? Window::CONTENT_SCALE_STRETCH_INTEGER : Window::CONTENT_SCALE_STRETCH_FRACTIONAL);
+		root->set_content_scale_size(Size2i(GLOBAL_GET("display/window/size/viewport_width"), GLOBAL_GET("display/window/size/viewport_height")));
+		root->set_content_scale_factor(GLOBAL_GET("display/window/stretch/scale"));
+		root->set_snap_controls_to_pixels(GLOBAL_GET("gui/common/snap_controls_to_pixels"));
+		root->set_default_canvas_item_texture_filter(Viewport::DefaultCanvasItemTextureFilter(int(GLOBAL_GET("rendering/textures/canvas_textures/default_texture_filter"))));
+		root->set_default_canvas_item_texture_repeat(Viewport::DefaultCanvasItemTextureRepeat(int(GLOBAL_GET("rendering/textures/canvas_textures/default_texture_repeat"))));
+	}
+
+	g->tree->initialize();
+	g->_load_autoloads();
+
+	Error err = OK;
+	Ref<PackedScene> scene_data = ResourceLoader::load(p_scene);
+	Node *scene = scene_data.is_valid() ? scene_data->instantiate() : nullptr;
+	if (scene) {
+		g->tree->add_current_scene(scene);
+	} else {
+		err = ERR_CANT_OPEN;
+	}
+	MessageQueue::get_singleton()->flush();
+
+	Engine::get_singleton()->set_editor_hint(prev_hint);
+	ScriptServer::set_scripting_enabled(prev_scripting);
+
+	if (err != OK) {
+		ERR_PRINT("Failed to load the scene to run: " + p_scene + ".");
+		g->finished_callback = Callable();
+		stop();
+		return err;
+	}
+	print_line(vformat("Running %s next to the editor.", p_scene));
+	return OK;
+}
+
+void InProcessGame::stop() {
+	if (!singleton || !singleton->tree || singleton->stopping) {
+		return;
+	}
+	InProcessGame *g = singleton;
+	g->stopping = true;
+	{
+		Scope scope;
+		g->tree->finalize();
+		memdelete(g->tree);
+		g->tree = nullptr;
+		MessageQueue::get_singleton()->flush();
+	}
+	for (const StringName &E : g->autoload_globals) {
+		for (int i = 0; i < ScriptServer::get_language_count(); i++) {
+			ScriptServer::get_language(i)->remove_named_global_constant(E);
+		}
+	}
+	g->autoload_globals.clear();
+	g->_restore_input_map();
+
+#ifndef PHYSICS_2D_DISABLED
+	for (const RID &E : g->paused_spaces_2d) {
+		PhysicsServer2D::get_singleton()->space_set_active(E, true);
+	}
+	PhysicsServer2D::get_singleton()->set_active(!Engine::get_singleton()->is_editor_hint());
+#endif
+#ifndef PHYSICS_3D_DISABLED
+	for (const RID &E : g->paused_spaces_3d) {
+		PhysicsServer3D::get_singleton()->space_set_active(E, true);
+	}
+	PhysicsServer3D::get_singleton()->set_active(!Engine::get_singleton()->is_editor_hint());
+#endif
+	g->paused_spaces_2d.clear();
+	g->paused_spaces_3d.clear();
+	OS::get_singleton()->set_low_processor_usage_mode(g->saved_low_processor_mode);
+	g->stopping = false;
+	print_line(vformat("--- Game stopped after %.1f s (exit code %d) ---", (OS::get_singleton()->get_ticks_msec() - g->start_ticks) / 1000.0, g->exit_code));
+
+	Callable cb = g->finished_callback;
+	g->finished_callback = Callable();
+	if (cb.is_valid()) {
+		cb.call_deferred();
+	}
+}
+
+void InProcessGame::physics_frame(double p_step) {
+	if (!is_running() || singleton->quit_requested) {
+		return;
+	}
+	Scope scope;
+	SceneTree *t = singleton->tree;
+	t->iteration_prepare();
+	if (t->physics_process(p_step)) {
+		singleton->quit_requested = true;
+	}
+	t->iteration_end();
+}
+
+void InProcessGame::process_frame(double p_step) {
+	if (!is_running()) {
+		return;
+	}
+	if (!singleton->quit_requested) {
+		Scope scope;
+		if (singleton->tree->process(p_step)) {
+			singleton->quit_requested = true;
+		}
+	}
+	if (singleton->quit_requested) {
+		// SceneTree::quit() stores the exit code in OS.
+		singleton->exit_code = OS::get_singleton()->get_exit_code();
+		OS::get_singleton()->set_exit_code(EXIT_SUCCESS);
+		stop();
+	}
+}
