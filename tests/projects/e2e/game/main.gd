extends Node2D
## Game side of the end-to-end test. It is started from the editor (EditorInterface.play_main_scene())
## and, on iPadOS, runs inside the editor's process after the editor has shut down. It checks that
## the engine runs the project normally (physics, input, audio, rendering), writes its results, and
## quits, which brings the editor back.

const RESULTS_DIR := "res://.test_results"

var checks := {}
var frames := 0
var start_y := 0.0
var touch_events := 0
var key_events := 0
var mouse_events := 0
var audio_player: AudioStreamPlayer


func check(name: String, ok: bool, detail := "") -> void:
	checks[name] = { "ok": ok, "detail": str(detail) }
	print("[game] %s: %s %s" % [name, "PASS" if ok else "FAIL", detail])


func _ready() -> void:
	print("[game] started, editor hint: ", Engine.is_editor_hint())
	check("game_not_editor_hint", not Engine.is_editor_hint())
	check("game_cmdline", true, " ".join(OS.get_cmdline_args()))
	start_y = $Body.position.y

	# Audio playback through the real audio server (CoreAudio on iOS).
	var wav_path := "res://generated/beep.wav"
	if ResourceLoader.exists(wav_path):
		audio_player = AudioStreamPlayer.new()
		audio_player.stream = load(wav_path)
		add_child(audio_player)
		audio_player.play()
	# Generated by the editor stage of the test; imported by the editor.
	var tex := load("res://generated/checker.png") as Texture2D
	check("game_loads_imported_texture", tex != null and tex.get_width() == 64, tex)
	var sprite := Sprite2D.new()
	sprite.texture = tex
	sprite.position = Vector2(300, 200)
	add_child(sprite)
	# Scene created and saved by the editor stage.
	var generated := load("res://generated/test_scene.tscn") as PackedScene
	check("game_loads_editor_saved_scene", generated != null and generated.can_instantiate())
	if generated:
		add_child(generated.instantiate())

	# Input map action added through ProjectSettings by the editor stage.
	check("game_has_editor_input_action", InputMap.has_action("podot_jump"))


func _input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		touch_events += 1
	elif event is InputEventKey:
		key_events += 1
	elif event is InputEventMouseButton:
		mouse_events += 1


func _physics_process(_delta: float) -> void:
	frames += 1
	if frames == 5:
		# Synthetic events through the regular input pipeline.
		var touch := InputEventScreenTouch.new()
		touch.index = 0
		touch.position = Vector2(50, 50)
		touch.pressed = true
		Input.parse_input_event(touch)
		touch = touch.duplicate()
		touch.pressed = false
		Input.parse_input_event(touch)
		var key := InputEventKey.new()
		key.keycode = KEY_SPACE
		key.physical_keycode = KEY_SPACE
		key.pressed = true
		Input.parse_input_event(key)
		if InputMap.has_action("podot_jump"):
			Input.action_press("podot_jump")
	if frames == 90:
		_finish()


func _finish() -> void:
	check("physics_body_fell", $Body.position.y > start_y + 1.0, "%s -> %s" % [start_y, $Body.position.y])
	check("input_touch_events", touch_events >= 2, touch_events)
	check("input_key_events", key_events >= 1, key_events)
	check("input_touch_emulates_mouse", mouse_events >= 1 or not ProjectSettings.get_setting("input_devices/pointing/emulate_mouse_from_touch"), mouse_events)
	if audio_player:
		check("audio_stream_playing", audio_player.playing or audio_player.get_playback_position() > 0.0, audio_player.get_playback_position())
	var img := get_viewport().get_texture().get_image() if DisplayServer.get_name() != "headless" else null
	if img:
		check("game_viewport_rendered", img.get_width() > 0 and not img.is_invisible(), img.get_size())
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(RESULTS_DIR))
	var f := FileAccess.open(RESULTS_DIR.path_join("game.json"), FileAccess.WRITE)
	f.store_string(JSON.stringify({ "checks": checks, "frames": frames, "display": DisplayServer.get_name(), "os": OS.get_name() }, "\t"))
	f.close()
	print("[game] done, quitting")
	get_tree().quit()
