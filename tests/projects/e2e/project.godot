; Engine configuration file.
; This project is the end-to-end test project for the iPadOS editor port.
; It is a regular Godot 4 project and also opens in the standard desktop editor.

config_version=5

[application]

config/name="Podot E2E Test"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/podot_test_runner/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
